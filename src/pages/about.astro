---
import Layout from "../layouts/Layout.astro";

// §2 Founding Structure
const founderRoles = [
  {
    role: "Chief Executive",
    promise: "Who we work with and what we promise.",
    owns: "Client relationships, commercial terms, account governance, and client-facing delivery accountability.",
  },
  {
    role: "Chief Technology Officer",
    promise: "How it is built and whether we can promise it.",
    owns: "Technical strategy, architecture, delivery engineering, hiring and mentoring, platform IP, and security and technical risk.",
  },
];

const sharedApprovals = [
  "Entering a new market",
  "Material pricing exceptions",
  "Debt or financing",
  "Senior hires",
  "Changes to the house stack",
  "Client work with unusual legal or security exposure",
  "Any assignment of company IP",
];

// §11 What We Say No To (public subset)
const declines = [
  "Staff augmentation with no architectural responsibility or path to transfer capability",
  "Fixed-scope waterfall on ambiguous requirements",
  "Taking over a codebase without a paid diagnostic",
  "Unpaid speculative estimates on systems we have not seen",
  "Engagements without a named counterpart and an executive sponsor",
  "Production responsibility without defined access, authority, and service levels",
  "Putting client data into AI tools without approved governance",
];

const shell = "mx-auto max-w-content px-[clamp(20px,5vw,80px)]";
---

<Layout
  title="About"
  description="Why NewCo exists, how the two founders split responsibility, and the work we turn down."
>
  <section class:list={[shell, "pt-16 pb-16 md:pt-20 md:pb-24"]}>
    <h1 class="max-w-[20ch] text-h1 text-ink text-balance">
      Engineering capability should be kept, not rented.
    </h1>
    <p class="mt-8 measure text-body-lg text-graphite">
      Most technology partners are built to stay indispensable. We are built for the opposite: a client who no longer
      needs us day to day, because their team was building that capability the whole time.
    </p>
  </section>

  <section class="border-t border-line bg-surface">
    <div class:list={[shell, "py-16 md:py-24"]}>
      <div class="grid gap-8 md:grid-cols-12 md:gap-x-6">
        <h2 class="text-h2 text-ink text-balance md:col-span-7">Two founders, one clear split.</h2>
        <p class="measure text-body-lg text-graphite md:col-span-5">
          No proposal leaves without technical sign-off, and no architecture or support commitment is made without
          commercial sign-off. Each founder holds one documented veto inside their own area.
        </p>
      </div>
      <div class="mt-16 grid gap-12 md:grid-cols-2 md:gap-8">
        {
          founderRoles.map((founder) => (
            <div class="border-t-2 border-ink pt-6">
              <h3 class="text-h3 text-ink">{founder.role}</h3>
              <p class="mt-3 text-body-lg font-medium text-ink">{founder.promise}</p>
              <p class="mt-3 text-body text-graphite">{founder.owns}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-10 measure text-body text-graphite">Portraits and biographies are added once approved.</p>
    </div>
  </section>

  <section class:list={[shell, "py-16 md:py-24"]}>
    <div class="grid gap-8 md:grid-cols-12 md:gap-x-6">
      <div class="md:col-span-5">
        <h2 class="text-h2 text-ink text-balance">Decided together.</h2>
        <p class="mt-6 text-body-lg text-graphite">
          Every decision is logged with its owner, rationale, assumptions, and a review date.
        </p>
      </div>
      <ul class="flex flex-col divide-y divide-line border-y border-line md:col-span-6 md:col-start-7">
        {sharedApprovals.map((item) => <li class="py-4 text-body-lg text-ink">{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="border-t border-line bg-surface">
    <div class:list={[shell, "py-16 md:py-24"]}>
      <div class="grid gap-8 md:grid-cols-12 md:gap-x-6">
        <div class="md:col-span-5">
          <h2 class="text-h2 text-ink text-balance">Work we turn down.</h2>
          <p class="mt-6 text-body-lg text-graphite">
            Saying no early is cheaper for both sides than a delivery model that quietly bends.
          </p>
        </div>
        <ul class="flex flex-col divide-y divide-line border-y border-line md:col-span-6 md:col-start-7">
          {declines.map((item) => <li class="py-4 text-body-lg text-graphite">{item}</li>)}
        </ul>
      </div>
    </div>
  </section>
</Layout>
