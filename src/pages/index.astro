---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import CapabilityCurve from "../components/CapabilityCurve.astro";
import CapabilityScorecard from "../components/CapabilityScorecard.astro";
import { Icon } from "astro-icon/components";

const dependencyCosts = [
  {
    default: "Build, invoice, disappear",
    remains: "A system nobody internally can operate",
  },
  {
    default: "Add people by the day",
    remains: "Temporary capacity without retained capability",
  },
  {
    default: "Add AI to weak foundations",
    remains: "A demo without trustworthy data or evaluation",
  },
  {
    default: "Handover as a final ZIP file",
    remains: "Vendor dependency disguised as delivery",
  },
];

const outcomes = [
  {
    name: "Capacity",
    body: "Your team ships and operates more of the roadmap without waiting on us.",
  },
  {
    name: "Longevity",
    body: "The system stays understandable as people, priorities, and vendors change.",
  },
  {
    name: "Leverage",
    body: "Sound data, a repeatable delivery path, and measured automation compound over time.",
  },
];

const diagnosticGroups = [
  {
    title: "Where you are",
    items: [
      "Architecture and dependency map",
      "Data-flow and data-readiness assessment",
      "Delivery and capability baseline",
    ],
  },
  {
    title: "What could go wrong",
    items: ["Security and operational risk register", "AI-readiness scorecard", "Build-versus-buy recommendations"],
  },
  {
    title: "What to do next",
    items: [
      "Prioritised 90-day backlog",
      "Twelve-month roadmap and run-cost estimate",
      "Capability-transfer plan",
    ],
  },
];

const maturityLadder = [
  { stage: "Data foundation", needs: "A baseline to start from" },
  { stage: "Decision support", needs: "Reliable data and a defined decision" },
  { stage: "Assistive AI", needs: "A permissioned corpus, evaluation set, and owner" },
  { stage: "Embedded intelligence", needs: "A feedback loop and a rollback path" },
  { stage: "Controlled automation", needs: "Measured accuracy, bounded permissions, and an audit trail" },
];

const goodFit = [
  "You run a complex, multi-location operation and want technology you own.",
  "You can name a person to work alongside our engineers and an executive who can decide.",
  "You want evidence before committing to a major build, migration, or AI initiative.",
];

const notFit = [
  "You want a one-off build with no shared operating responsibility.",
  "You are comparing day rates before deciding what the system needs.",
  "You want AI shipped before the data, ownership, and safeguards it depends on.",
];

const shell = "mx-auto max-w-content px-[clamp(20px,5vw,80px)]";
---

<Layout
  title="Engineering capacity you keep"
  description="NewCo builds with your team, operates the system with you, and measures progress toward your independence."
>
  <!-- Hero -->
  <section class:list={[shell, "pt-16 pb-24 md:pt-20 md:pb-24"]}>
    <div class="grid gap-12 md:grid-cols-12 md:gap-x-6">
      <div class="md:col-span-7">
        <h1 class="text-[clamp(2.75rem,9vw,6.5rem)] leading-[1.02] font-extrabold text-ink text-balance tracking-[-0.03em]">Engineering capacity you keep.</h1>
        <p class="mt-8 measure text-body-lg text-graphite">
          We build with your team, operate the system with you, and measure progress toward your
          independence. Built for operators whose technology has outgrown the people who can run it.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <Button href="/contact" variant="primary">Discuss your situation</Button>
          <Button href="#capability-curve" variant="secondary">See the engagement model</Button>
        </div>
      </div>

      <div class="md:col-span-5 md:col-start-8">
        <CapabilityCurve compact />
      </div>
    </div>
  </section>

  <!-- Problem -->
  <section class="border-t border-line bg-surface">
    <div class:list={[shell, "py-16 md:py-24"]}>
      <h2 class="max-w-[24ch] text-h2 text-ink text-balance">
        Most technology problems are operating-model problems.
      </h2>
      <p class="mt-6 measure text-body-lg text-graphite">
        A release is not the same as capability. You can hold working software and still have no one
        who can defend its architecture, run its recovery, or extend it without the vendor who wrote
        it.
      </p>

      <div class="mt-16 hidden gap-x-6 border-b border-line pb-4 md:grid md:grid-cols-12">
        <p class="label text-graphite md:col-span-6">The usual arrangement</p>
        <p class="label text-signal md:col-span-6">What you are left with</p>
      </div>

      <dl class="flex flex-col divide-y divide-line border-y border-line md:border-t-0 max-md:mt-16">
        {
          dependencyCosts.map((row) => (
            <div class="grid gap-x-6 gap-y-2 py-6 md:grid-cols-12">
              <dt class="text-h3 text-ink md:col-span-6">{row.default}</dt>
              <dd class="text-body text-graphite md:col-span-6 md:text-body-lg">{row.remains}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Engagement model -->
  <section id="capability-curve" class:list={[shell, "scroll-mt-24 py-24 md:py-32"]}>
    <div class="grid gap-8 md:grid-cols-12 md:gap-x-6">
      <h2 class="text-h2 text-ink text-balance md:col-span-7">
        A route from external support to internal ownership.
      </h2>
      <div class="md:col-span-5">
        <p class="text-body-lg text-graphite">
          We diagnose, build with your team, then run the system together. Your team shadows the
          pager, then shares it. Advisory support remains after the transfer.
        </p>
        <a href="/approach" class="mt-4 inline-block text-body font-medium text-signal underline underline-offset-4 hover:text-signal-dark">
          Read the full approach
        </a>
      </div>
    </div>

    <div class="mt-16">
      <CapabilityCurve />
    </div>
  </section>

  <!-- Capability-transfer scorecard: the signature element -->
  <section class="border-t border-line bg-ink text-canvas">
    <div class:list={[shell, "py-24 md:py-32"]}>
      <div class="grid gap-8 md:grid-cols-12 md:gap-x-6">
        <h2 class="text-h1 text-canvas text-balance md:col-span-7">Handover is proven, not declared.</h2>
        <p class="measure text-body-lg text-canvas/80 md:col-span-5 md:self-end">
          Your named counterpart is assessed against the same eight capabilities at four checkpoints.
          Handover is complete when they perform each one independently, not when a training session
          ends.
        </p>
      </div>

      <div class="mt-16">
        <CapabilityScorecard tone="dark" />
      </div>

      <p class="mt-10 measure text-body text-canvas/70">
        We have no client case studies to publish yet. Alongside the scorecard we baseline lead time,
        deployment frequency, change-failure rate, recovery time, rework, and onboarding-to-first-PR,
        and report against them as the work runs.
      </p>
    </div>
  </section>

  <!-- Outcomes -->
  <section class:list={[shell, "py-24 md:py-32"]}>
    <h2 class="max-w-[22ch] text-h2 text-ink text-balance">The deliverable is more than software.</h2>
    <div class="mt-16 grid gap-12 md:grid-cols-3 md:gap-8">
      {
        outcomes.map((outcome) => (
          <div class="border-t-2 border-ink pt-6">
            <h3 class="text-h3 text-ink">{outcome.name}</h3>
            <p class="mt-3 text-body-lg text-graphite">{outcome.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Technical Diagnostic -->
  <section class="border-t border-line bg-surface">
    <div class:list={[shell, "py-24 md:py-32"]}>
      <div class="grid gap-8 md:grid-cols-12 md:gap-x-6">
        <h2 class="text-h2 text-ink text-balance md:col-span-7">
          Start with evidence, not a speculative estimate.
        </h2>
        <p class="measure text-body-lg text-graphite md:col-span-5">
          A fixed-fee Technical Diagnostic in 15 business days. You own the output and can take it to
          any vendor.
        </p>
      </div>

      <div class="mt-16 grid gap-12 md:grid-cols-3 md:gap-8">
        {
          diagnosticGroups.map((group) => (
            <div>
              <h3 class="border-b border-line pb-4 text-h3 text-ink">{group.title}</h3>
              <ul class="mt-4 flex flex-col gap-3">
                {group.items.map((item) => (
                  <li class="text-body-lg text-graphite">{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <div class="mt-12">
        <Button href="/diagnostic" variant="secondary">What the diagnostic covers</Button>
      </div>
    </div>
  </section>

  <!-- AI -->
  <section class:list={[shell, "py-24 md:py-32"]}>
    <div class="grid gap-8 md:grid-cols-12 md:gap-x-6">
      <h2 class="text-h2 text-ink text-balance md:col-span-7">AI has to earn its place.</h2>
      <p class="measure text-body-lg text-graphite md:col-span-5">
        Not every engagement needs AI. The diagnostic picks the lowest level that creates measurable
        value and names what the next one requires. Every AI feature ships with an owner, an evaluation
        suite, a cost budget, and a safe way to switch it off.
      </p>
    </div>

    <dl class="mt-16 grid border-t border-line md:grid-cols-5">
      {
        maturityLadder.map((rung) => (
          <div class="flex flex-col gap-2 border-b border-line py-6 md:border-b-0 md:border-l md:px-5 md:first:border-l-0 md:first:pl-0">
            <dt class="text-body-lg font-semibold text-ink">{rung.stage}</dt>
            <dd class="text-body text-graphite">{rung.needs}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Fit -->
  <section class="border-t border-line bg-surface">
    <div class:list={[shell, "py-24 md:py-32"]}>
      <h2 class="max-w-[24ch] text-h2 text-ink text-balance">
        We work best when ownership is part of the brief.
      </h2>

      <div class="mt-16 grid gap-12 md:grid-cols-2 md:gap-8">
        <div>
          <h3 class="border-b border-line pb-4 text-h3 text-success">Good fit</h3>
          <ul class="mt-6 flex flex-col gap-4">
            {
              goodFit.map((item) => (
                <li class="flex items-start gap-3 text-body-lg text-ink">
                  <Icon name="solar:check-circle-linear" class="mt-1 h-5 w-5 shrink-0 text-success" aria-hidden="true" />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="border-b border-line pb-4 text-h3 text-graphite">Probably not a fit</h3>
          <ul class="mt-6 flex flex-col gap-4">
            {
              notFit.map((item) => (
                <li class="flex items-start gap-3 text-body-lg text-graphite">
                  <Icon name="solar:close-circle-linear" class="mt-1 h-5 w-5 shrink-0 text-graphite" aria-hidden="true" />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="border-t border-line">
    <div class:list={[shell, "py-24 md:py-32"]}>
      <h2 class="max-w-[18ch] text-h1 text-ink text-balance">Own the next stage of your technology.</h2>
      <p class="mt-8 measure text-body-lg text-graphite">
        Tell us where your systems, data, delivery, or internal capability are holding the business
        back. We will tell you honestly whether a diagnostic is the right next step. No speculative
        estimate, and no obligation to continue afterwards.
      </p>
      <div class="mt-10">
        <Button href="/contact" variant="primary">Discuss your situation</Button>
      </div>
    </div>
  </section>
</Layout>
