---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import { Icon } from "astro-icon/components";
import { pad, shell } from "../lib/ui";

const founders = [
  { name: "Vanezza", role: "Chief Executive Officer", roleKey: "about.team.role-ceo", alt: "Vanezza, Chief Executive Officer", altKey: "about.team.alt-ceo", image: "/images/ceo.webp", bio: "Vanezza leads client strategy and operations. She translates business goals into clear technical scope and ensures every engagement delivers measurable value.", bioKey: "about.team.bio-ceo" },
  { name: "Agung Denisa", role: "Chief Technology Officer", roleKey: "about.team.role-cto", alt: "Agung Denisa, Chief Technology Officer", altKey: "about.team.alt-cto", image: "/images/cto.webp", bio: "Agung architects the systems Kyron Engineering builds and owns the technical standards. He reviews every proposal for feasibility, maintainability, and security.", bioKey: "about.team.bio-cto", linkedin: "https://www.linkedin.com/in/agung78/" },
];

const commitments = [
  { icon: "solar:chat-round-dots-linear", title: "Plain-language updates.", titleKey: "about.commitments.plain-title", description: "No jargon, no surprises.", descKey: "about.commitments.plain-desc" },
  { icon: "solar:tag-price-linear", title: "Clear pricing.", titleKey: "about.commitments.pricing-title", description: "Agreed upfront, before work begins.", descKey: "about.commitments.pricing-desc" },
  {
    icon: "solar:user-speak-linear",
    title: "A real person to talk to.",
    titleKey: "about.commitments.contact-title",
    description: "A named contact and agreed response times.",
    descKey: "about.commitments.contact-desc",
  },
  {
    icon: "solar:shield-check-linear",
    title: "Honest advice.",
    titleKey: "about.commitments.honest-title",
    description: "We recommend what's right for the business, not what costs the most.",
    descKey: "about.commitments.honest-desc",
  },
];
---

<Layout titleKey="meta.about.title" descKey="meta.about.description" lcpImage="/images/ceo.webp">
  <section class="bg-white">
    <div class:list={[shell, "py-16 md:py-24"]}>
      <span class="mono text-blue" data-i18n="about.hero.eyebrow">// LEADERSHIP &amp; COMMITMENTS</span>
      <div class="mt-6 grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12">
        <h1 class="text-h1 uppercase text-navy text-balance tracking-tight lg:col-span-7" data-i18n="about.hero.title">Built on trust, delivered with care.</h1>
        <p class="text-body-lg text-slate lg:col-span-5 lg:pt-2" data-i18n="about.hero.lede">
          Your technology partner, start to finish. We design, build and support the systems businesses rely on every day.
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-mist py-16 md:py-24">
    <div class={shell}>
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:gap-12">
        <h2 class="text-h2 text-navy text-balance lg:col-span-5" data-i18n="about.team.title">The team behind Kyron Engineering.</h2>
        <p class="text-body-lg text-slate lg:col-span-7" data-i18n="about.team.lede">
          Every proposal is checked by both founders, one for the business side and one for the technical side, so what we promise is always what we can deliver.
        </p>
      </div>
      <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-2">
        {
          founders.map((f, i) => (
            <figure itemscope itemtype="https://schema.org/Person" itemref="#organization">
              <img
                src={f.image}
                alt={f.alt}
                data-i18n-attr={"alt:" + f.altKey}
                width="400"
                height="500"
                loading="eager"
                fetchpriority={i === 0 ? "high" : "auto"}
                decoding="async"
                class="aspect-[4/5] w-full max-w-full h-auto rounded-xl border border-line object-cover object-top overflow-hidden"
                itemprop="image"
              />
              <figcaption class="mt-4 flex items-start justify-between gap-4 border-t border-navy pt-4">
                <div>
                  <h3 class="text-h3 font-semibold text-navy" itemprop="name">{f.name}</h3>
                  <p class="text-sm text-grey mt-1" data-i18n={f.roleKey} itemprop="jobTitle">{f.role}</p>
                  <p class="text-body text-slate mt-2" data-i18n={f.bioKey} itemprop="description">{f.bio}</p>
                  {f.linkedin && (
                    <a href={f.linkedin} class="text-sm text-blue underline mt-2 inline-block" target="_blank" rel="noopener" itemprop="sameAs" aria-label={`${f.name} on LinkedIn`}>LinkedIn</a>
                  )}
                </div>
                <span class="mono text-blue">{pad(i)}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-white py-16 md:py-24">
    <div class={shell}>
      <h2 class="text-h2 text-navy text-balance" data-i18n="about.commitments.title">What every client can count on.</h2>
      <ul class="mt-12 grid grid-cols-1 overflow-hidden rounded-xl border border-line bg-white md:grid-cols-2">
        {
          commitments.map((item, i) => (
            <li class="flex gap-4 border-t border-line p-6 first:border-t-0 md:nth-2:border-t-0 md:odd:border-r md:p-8">
              <Icon name={item.icon} class="h-8 w-8 shrink-0 text-navy" aria-hidden="true" />
              <div>
                <span class="mono text-blue">{pad(i)}</span>
                <h3 class="text-h3 font-semibold text-navy mt-2" data-i18n={item.titleKey}>{item.title}</h3>
                <p class="text-body text-slate mt-1" data-i18n={item.descKey}>{item.description}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <div class="mt-16 border-t border-line pt-12">
        <h3 class="text-h3 font-semibold text-navy" data-i18n="about.commitments.work-title">How we work with your leadership</h3>
        <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-8 text-body text-slate">
          <p data-i18n="about.commitments.work-p1">We work directly alongside your existing engineers, technical leads, and founders. Rather than operating in an isolated agency silo, our engineers join your sprints, review pull requests with your team, and establish shared coding standards from day one.</p>
          <p data-i18n="about.commitments.work-p2">Every architecture decision, infrastructure deployment, and operational runbook is documented directly in your repositories. When our engagement concludes, your business holds complete, autonomous ownership of the code, systems, and deployment pipelines.</p>
        </div>
      </div>
      <div class="mt-12 flex flex-col justify-between gap-6 rounded-xl border border-line bg-mist p-6 md:flex-row md:items-center md:p-8">
        <div>
          <h3 class="text-h3 font-semibold text-navy" data-i18n="about.overview.title">Want a quick overview?</h3>
          <p class="mt-2 max-w-[54ch] text-body text-slate" data-i18n="about.overview.body">
            See how Kyron Engineering works, what we deliver, and how ownership transfers to your business.
          </p>
        </div>
        <Button
          href="/downloads/kyron-engineering-company-overview-en.pdf"
          variant="secondary"
          class="shrink-0"
          target="_blank"
          rel="noopener"
          data-i18n-attr="href:overview.href"
        >
          <span data-i18n="overview.link">View company overview (PDF)</span>
        </Button>
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-white py-16 md:py-24">
    <div class={shell}>
      <div class="max-w-[72ch]">
        <span class="mono text-blue" data-i18n="about.philosophy.eyebrow">// OUR PHILOSOPHY</span>
        <h2 class="mt-4 text-h2 text-navy text-balance" data-i18n="about.philosophy.heading">Engineering principles that outlast our engagement.</h2>
        <p class="mt-4 text-body-lg text-slate" data-i18n="about.philosophy.lede">
          We believe technology should serve business growth without creating perpetual vendor dependence. These four commitments govern how we architect and build.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-2">
        <div class="rounded-xl border border-line bg-mist p-6 md:p-8">
          <h3 class="text-h3 font-semibold text-navy" data-i18n="about.philosophy.p1-title">Zero lock-in architecture</h3>
          <p class="mt-3 text-body text-slate" data-i18n="about.philosophy.p1-body">
            Every architectural decision prioritizes open standards, clean API boundaries, and mainstream cloud primitives. Your team can run, modify, or migrate your systems anywhere without proprietary hurdles.
          </p>
        </div>
        <div class="rounded-xl border border-line bg-mist p-6 md:p-8">
          <h3 class="text-h3 font-semibold text-navy" data-i18n="about.philosophy.p2-title">Continuous documentation</h3>
          <p class="mt-3 text-body text-slate" data-i18n="about.philosophy.p2-body">
            Architecture decision records, deployment runbooks, and schema maps live directly in version control alongside application source code, ensuring knowledge is never lost to employee turnover.
          </p>
        </div>
        <div class="rounded-xl border border-line bg-mist p-6 md:p-8">
          <h3 class="text-h3 font-semibold text-navy" data-i18n="about.philosophy.p3-title">Shared code ownership</h3>
          <p class="mt-3 text-body text-slate" data-i18n="about.philosophy.p3-body">
            We write software for the engineers who will maintain it years down the road. Strict typing, automated linters, and end-to-end integration tests prevent regressions and maintain velocity.
          </p>
        </div>
        <div class="rounded-xl border border-line bg-mist p-6 md:p-8">
          <h3 class="text-h3 font-semibold text-navy" data-i18n="about.philosophy.p4-title">Pragmatic innovation</h3>
          <p class="mt-3 text-body text-slate" data-i18n="about.philosophy.p4-body">
            New tools and frameworks are evaluated against maintenance burden and measurable business return before adoption. We recommend boring, reliable solutions whenever they deliver equal or superior value.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-mist">
    <div class:list={[shell, "py-16 md:py-24"]}>
      <div class="corners rounded-xl border border-line bg-white p-8 md:p-16">
        <div class="grid grid-cols-1 items-end gap-8 lg:grid-cols-12 lg:gap-12">
          <div class="lg:col-span-8">
            <h2 class="max-w-[22ch] text-h2 text-navy text-balance" data-i18n="about.cta.title">
              If this is how you want to work, tell us where things stand.
            </h2>
            <p class="mt-6 max-w-[68ch] text-body text-slate text-pretty" data-i18n="about.cta.body">
              We'll look at your systems, constraints and goals, then give you an honest recommendation on the best way forward.
            </p>
          </div>
          <div class="lg:col-span-4 lg:justify-self-end">
            <Button href="/contact" variant="primary" class="md:whitespace-nowrap"><span data-i18n="about.cta.button">Talk to us</span></Button>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
