---
type BaseProps = {
  variant?: "primary" | "secondary" | "third" | "tertiary" | "inverse";
  class?: string;
  [attr: string]: unknown;
};

type Props =
  | (BaseProps & { href: string; type?: never })
  | (BaseProps & { href?: never; type: "submit" | "button"; disabled?: boolean });

// The index signature in BaseProps widens the union's own keys to `unknown`
// on read, so the element-facing attributes are re-narrowed here.
const {
  variant = "primary",
  class: className = "",
  href,
  type,
  disabled,
  ...rest
} = Astro.props as BaseProps & {
  href?: string;
  type?: "submit" | "button";
  disabled?: boolean;
};

const base =
  "rounded-[8px] min-h-[48px] inline-flex items-center justify-center gap-2 px-[18px] py-3 text-body font-semibold transition-[color,background-color,border-color,transform] duration-[var(--duration-press)] ease-[var(--ease-out)] active:scale-[0.97] disabled:opacity-60 disabled:active:scale-100";
const variants = {
  primary: "bg-primary hover:bg-primary-dark text-white shadow-xs",
  secondary: "bg-white text-navy border border-navy hover:bg-secondary/15 hover:border-primary hover:text-primary",
  third: "bg-third hover:bg-third-dark text-navy font-semibold shadow-xs",
  tertiary: "bg-third hover:bg-third-dark text-navy font-semibold shadow-xs",
  inverse: "bg-white text-navy hover:bg-mist",
};
const classes = `${base} ${variants[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} disabled={disabled} class={classes} {...rest}>
      <slot />
    </button>
  )
}
