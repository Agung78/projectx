---
const links = [
  { href: "/", label: "Home" },
  { href: "/how-we-work", label: "How we work" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];
---

<footer class="border-t border-white/10 bg-navy text-white">
  <div class="mx-auto max-w-[1200px] px-4 md:px-6 pt-16 pb-8">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1.4fr]">
      <div class="max-w-measure">
        <p class="text-h3 font-semibold text-white">NewCo</p>
        <p class="mt-4 text-body text-white/70">
          Systems built properly, documented fully, and owned by the business.
        </p>
        <a
          href="/contact"
          class="mt-8 inline-block rounded-md bg-white px-5 py-3 font-semibold text-navy hover:bg-mist"
        >
          Start a conversation
        </a>
      </div>

      <nav aria-label="Footer">
        <p class="text-sm font-semibold uppercase tracking-wider text-white/50">Company</p>
        <ul class="mt-4 flex flex-col gap-3">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class="text-body text-white/80 hover:text-white">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <address class="not-italic">
        <p class="text-sm font-semibold uppercase tracking-wider text-white/50">Registered office</p>
        <p class="mt-4 font-semibold text-white">PT NewCo Teknologi Indonesia</p>
        <p class="mt-1 text-body text-white/70">
          One Pacific Place, Level 11, SCBD, Jl. Jend. Sudirman Kav. 52-53, Jakarta Selatan 12190, Indonesia
        </p>
        <p class="mt-3 text-sm text-white/60">NIB / Company Registration: 0120202688192</p>
      </address>
    </div>

    <div class="mt-16 flex flex-col gap-2 border-t border-white/10 pt-6 text-sm text-white/60 sm:flex-row sm:justify-between">
      <p>&copy; {new Date().getFullYear()} NewCo. All rights reserved.</p>
      <a href="/privacy" class="hover:text-white">Privacy</a>
    </div>
  </div>
</footer>
