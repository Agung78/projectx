---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import CapabilityCurve from "../components/CapabilityCurve.astro";
import { Icon } from "astro-icon/components";

const proofLine = ["Build with your team", "Operate the system together", "Measure the path to independence"];

// Two lines, split into words so each can reveal in reading order. The full
// sentence stays in the DOM as ordinary inline text for assistive technology.
const taglineLines = [
  "Engineering capability you keep.",
  "We build with your team, operate the system with you, and measure the path to independence.",
].map((line) => line.split(" "));

const dependencyCosts = [
  { name: "Project shop", default: "Build, invoice, disappear", remains: "A system nobody internally can operate" },
  { name: "Body shopping", default: "Add people by the day", remains: "Temporary capacity without retained capability" },
  {
    name: "AI wrapper without foundations",
    default: "Add AI to weak foundations",
    remains: "A demo without trustworthy data, evaluation, or owner",
  },
  {
    name: "Handover as a ZIP file",
    default: "Sign off, archive repository, exit",
    remains: "Vendor dependency disguised as delivery",
  },
];

const outcomes = [
  {
    name: "Capacity",
    body: "Your team ships and operates more of the roadmap without waiting on us.",
    cue: "Lead time, deployment frequency, onboarding to first PR",
  },
  {
    name: "Longevity",
    body: "The system stays understandable as people, priorities, and vendors change.",
    cue: "Capability scorecard progress, recovery time, runbook execution",
  },
  {
    name: "Leverage",
    body: "Sound data, a repeatable delivery path, and measured automation compound over time.",
    cue: "Rework rate, change failure rate, platform reuse",
  },
];

const phases = ["Diagnose", "Build With", "Run With", "Hand Over", "Advise"];

const diagnosticGroups = [
  {
    title: "Where you are",
    items: [
      "Architecture and dependency map",
      "Data flow and data readiness assessment",
      "Delivery and capability baseline",
    ],
  },
  {
    title: "What could go wrong",
    items: ["Security and operational risk register", "AI readiness scorecard", "Build or buy recommendations"],
  },
  {
    title: "What to do next",
    items: [
      "Prioritised backlog for the first 90 days",
      "Twelve month roadmap and run cost estimate",
      "Target operating model",
      "Capability transfer plan",
    ],
  },
];

const principles = [
  {
    name: "Smallest appropriate architecture",
    body: "Split services only when a measured boundary justifies the operational cost.",
  },
  {
    name: "Operations are part of engineering",
    body: "Reliability, cost, security, backups, and recovery belong in the product.",
  },
  {
    name: "AI earns its place",
    body: "Use it where it improves quality or speed; build it into products only when evidence and controls exist.",
  },
  {
    name: "Replaceable by design",
    body: "Exportable data, documented interfaces, reproducible environments, and transferable operations.",
  },
  { name: "Measure claims", body: "Publish evidence, not activity or aspiration." },
];

const maturityLadder = [
  { stage: "Data foundation", needs: "Instrumentation, governed sources, warehouse, honest dashboard." },
  { stage: "Decision support", needs: "Reliable data and a defined decision." },
  { stage: "Assistive AI", needs: "Permissioned corpus, evaluation set, and owner." },
  { stage: "Embedded intelligence", needs: "Feedback loop and rollback path." },
  { stage: "Controlled automation", needs: "Measured accuracy, bounded permissions, and audit trail." },
];

const metrics = [
  { name: "Lead time to production", category: "DORA" },
  { name: "Deployment frequency", category: "DORA" },
  { name: "Change failure rate", category: "DORA" },
  { name: "Mean time to recovery (MTTR)", category: "DORA" },
  { name: "Delivery rework rate", category: "Quality" },
  { name: "Onboarding to first merged PR", category: "Velocity" },
  { name: "Platform IP reuse", category: "Leverage" },
  { name: "Capability scorecard progress", category: "Capability" },
];

const goodFit = [
  "Multi-location operations wanting owned tech.",
  "A named client counterpart and an executive decision-maker.",
  "An evidence-first approach before large builds.",
];

const notFit = [
  "A single build with no shared operating responsibility.",
  "A day rate comparison before requirements.",
  "AI shipped before data and safeguards.",
];

const pad = (i: number) => String(i + 1).padStart(2, "0");
const shell = "mx-auto max-w-content px-[clamp(20px,5vw,80px)]";
// Buttons hold one line on desktop; they may wrap only in narrow mobile columns.
const btn = "md:whitespace-nowrap";
const link = "text-body font-medium text-signal underline underline-offset-4 hover:text-signal-dark md:whitespace-nowrap";
---

<Layout
  title="Engineering capacity you keep"
  description="NewCo builds with your team, operates systems together, and systematically measures progress toward your complete engineering independence."
>
  <!-- 1. Hero -->
  <section class:list={[shell, "pt-16 pb-24 md:pt-20"]}>
    <div class="grid gap-12 md:grid-cols-12 md:gap-x-6">
      <div class="md:col-span-7">
        <p class="mono text-signal" data-hero-item>[ EMBEDDED ENGINEERING CAPABILITY PARTNER ]</p>
        <h1 class="mt-6 text-h1 text-ink text-balance tracking-tight" data-hero-item>Build the technology your business can own.</h1>
        <p class="mt-8 measure text-body-lg text-graphite text-pretty" data-hero-item>
          For executives running operations across many locations, where technology has outgrown the
          people who can run it. We start with a paid Technical Diagnostic, then build with your team
          and hand over what we build.
        </p>
        <div class="mt-10 flex flex-wrap gap-4" data-hero-item>
          <Button href="/contact" variant="primary" class={btn}>Discuss your situation</Button>
          <Button href="#capability-curve" variant="secondary" class={btn}>See the capability transfer</Button>
        </div>
        <ul class="mono mt-12 flex flex-col gap-2 border-t border-line pt-5 text-ink lg:flex-row lg:gap-0 lg:divide-x lg:divide-line" aria-label="How we work">
          {proofLine.map((item) => <li class="lg:px-4 lg:first:pl-0">{item}</li>)}
        </ul>
      </div>

      <div class="md:col-span-5 md:col-start-8" data-hero-item>
        <div class="border border-ink bg-surface">
          <div class="mono flex items-center justify-between border-b border-line px-4 py-3 text-graphite">
            <span>[ PHASE TELEMETRY ]</span>
            <span>5 PHASES</span>
          </div>
          <div class="p-4 md:p-6">
            <CapabilityCurve compact />
          </div>
          <div class="mono flex items-center justify-between gap-4 border-t border-line px-4 py-3">
            <span class="border border-signal px-2 py-0.5 text-signal">[ MILESTONE: HANDOVER ]</span>
            <span class="text-graphite">OWNERSHIP SHIFTS</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Core thesis -->
  <section class="border-t border-line" aria-label="Tagline">
    <div class:list={[shell, "py-24 md:py-32"]}>
      <p class="mono mb-8 text-graphite">[ CORE THESIS ]</p>
      <p class="max-w-[24ch] text-4xl font-semibold text-ink text-balance md:text-5xl lg:max-w-[680px] lg:text-6xl" data-tagline-reveal>
        {
          taglineLines.map((words, lineIndex) => (
            <span class:list={["block", lineIndex > 0 && "mt-8 text-2xl font-medium text-graphite md:text-3xl"]}>
              {words.map((word) => (
                <>
                  <span class="inline-block" data-tagline-word>{word}</span>{" "}
                </>
              ))}
            </span>
          ))
        }
      </p>
    </div>
  </section>

  <!-- 3. Market gap -->
  <section class="border-t border-line bg-surface">
    <div class:list={[shell, "py-16 md:py-24"]}>
      <p class="mono text-signal">[ THE DEPENDENCY COST ]</p>
      <h2 class="mt-3 max-w-[24ch] text-h2 text-ink text-balance">
        Most technology problems are operating-model problems.
      </h2>
      <p class="mt-6 measure text-body-lg text-graphite text-pretty">
        Shipping software is not the same as retaining operational capability. You can hold working
        software and still have no one who can defend its architecture, run its recovery, or extend it
        without the vendor who wrote it.
      </p>

      <div class="mt-12 hidden gap-x-6 border-b border-ink pb-4 md:grid md:grid-cols-12">
        <p class="mono text-graphite md:col-span-6">The usual arrangement</p>
        <p class="mono text-signal md:col-span-6">What you are left with</p>
      </div>

      <dl class="flex flex-col divide-y divide-line border-b border-line max-md:mt-12 max-md:border-t max-md:border-ink">
        {
          dependencyCosts.map((row) => (
            <div class="grid gap-x-6 gap-y-2 py-6 md:grid-cols-12">
              <dt class="md:col-span-6">
                <span class="text-h3 text-ink">{row.name}</span>
                {row.default && <span class="mono mt-1 block text-graphite">[ {row.default} ]</span>}
              </dt>
              <dd class="text-body text-graphite md:col-span-6 md:text-body-lg">{row.remains}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- 4. Outcomes -->
  <section class:list={[shell, "py-24 md:py-32"]}>
    <h2 class="max-w-[22ch] text-h2 text-ink text-balance">The deliverable is more than software.</h2>
    <div class="mt-12 grid gap-12 md:grid-cols-3 md:gap-8" data-reveal-group>
      {
        outcomes.map((outcome, i) => (
          <div class="border-t-2 border-ink pt-6" data-reveal-item>
            <p class="mono text-signal">[{pad(i)}]</p>
            <h3 class="mt-3 text-h3 text-ink">{outcome.name}</h3>
            <p class="mt-3 text-body-lg text-graphite text-pretty">{outcome.body}</p>
            <p class="mono mt-6 text-graphite">Evidence baselined</p>
            <p class="mt-1 text-body text-ink">{outcome.cue}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 5. Capability curve -->
  <section id="capability-curve" class="scroll-mt-24 border-t border-line bg-surface">
    <div class:list={[shell, "py-24 md:py-32"]}>
      <div class="grid gap-8 md:grid-cols-12 md:gap-x-6">
        <div class="md:col-span-7">
          <p class="mono text-signal">[ ENGAGEMENT MODEL ]</p>
          <h2 class="mt-3 text-h2 text-ink text-balance">A route from external support to internal ownership.</h2>
        </div>
        <div class="md:col-span-5">
          <p class="text-body-lg text-graphite text-pretty">
            We diagnose, build with your team, then run the system together. Your team shadows the
            pager, then shares it. Advisory support remains after the transfer.
          </p>
          <a href="/approach" class:list={["mt-4 inline-block", link]}>Read the full approach</a>
        </div>
      </div>

      <ol class="mono mt-12 grid grid-cols-2 border-y border-line md:grid-cols-5" aria-label="Engagement phases">
        {
          phases.map((phase, i) => (
            <li class="border-b border-line py-3 pr-4 text-ink max-md:odd:border-r max-md:even:pl-4 md:border-b-0 md:border-l md:pl-4 md:first:border-l-0 md:first:pl-0">
              <span class="text-graphite">{pad(i)}</span> {phase}
            </li>
          ))
        }
      </ol>

      <div class="mt-12">
        <CapabilityCurve />
      </div>
    </div>
  </section>

  <!-- 6. Technical Diagnostic -->
  <section id="diagnostic" class:list={[shell, "scroll-mt-24 py-24 md:py-32"]}>
    <div class="border border-ink bg-surface p-6 md:p-12">
      <div class="grid gap-12 md:grid-cols-12 md:gap-x-6">
        <div class="md:col-span-5">
          <p class="mono inline-block border border-signal px-2 py-0.5 text-signal">[ TECHNICAL DIAGNOSTIC ]</p>
          <h2 class="mt-5 text-h2 text-ink text-balance">Start with evidence, not a speculative estimate.</h2>
          <dl class="mt-8 grid grid-cols-1 divide-y divide-line border-y border-line">
            <div class="py-4">
              <dt class="mono text-graphite">Duration</dt>
              <dd class="mt-1 text-h3 text-ink">15 business days</dd>
            </div>
            <div class="py-4">
              <dt class="mono text-graphite">Commercial form</dt>
              <dd class="mt-1 text-h3 text-ink">Fixed fee standalone product</dd>
            </div>
          </dl>
          <p class="mt-8 border border-signal p-4 text-body-lg font-medium text-ink">
            You own the diagnostic outputs and can take them to any vendor.
          </p>
        </div>

        <div class="md:col-span-7">
          <p class="mono text-graphite">[ 10 DELIVERABLES ]</p>
          <div class="mt-4 grid gap-8 md:grid-cols-3 md:gap-6">
            {
              diagnosticGroups.map((group) => (
                <div>
                  <h3 class="border-b border-ink pb-3 text-body-lg font-semibold text-ink">{group.title}</h3>
                  <ul class="mt-4 flex flex-col gap-3">
                    {group.items.map((item) => (
                      <li class="border-b border-line pb-3 text-body text-graphite">{item}</li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
          <div class="mt-12 flex flex-wrap items-center gap-x-6 gap-y-4">
            <Button href="/contact" variant="primary" class={btn}>Discuss your situation</Button>
            <a href="/diagnostic" class={link}>Explore the Technical Diagnostic</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Engineering principles -->
  <section class="border-t border-line">
    <div class:list={[shell, "py-24 md:py-32"]}>
      <div class="grid gap-8 md:grid-cols-12 md:gap-x-6">
        <h2 class="text-h2 text-ink text-balance md:col-span-7">Opinionated about ownership. Pragmatic about technology.</h2>
        <div class="md:col-span-5 md:self-end">
          <a href="/approach" class={link}>See the architecture in the approach</a>
        </div>
      </div>

      <ol class="mt-12 border-t border-ink" data-reveal-group>
        {
          principles.map((principle, i) => (
            <li class="grid gap-x-6 gap-y-2 border-b border-line py-6 md:grid-cols-12" data-reveal-item>
              <span class="mono text-signal md:col-span-1">[{pad(i)}]</span>
              <h3 class="text-h3 text-ink md:col-span-5">{principle.name}</h3>
              <p class="text-body text-graphite text-pretty md:col-span-6 md:text-body-lg">{principle.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 8. AI maturity -->
  <section class="border-t border-line bg-surface">
    <div class:list={[shell, "py-24 md:py-32"]}>
      <div class="grid gap-8 md:grid-cols-12 md:gap-x-6">
        <div class="md:col-span-7">
          <p class="mono text-signal">[ AI MATURITY ]</p>
          <h2 class="mt-3 text-h2 text-ink text-balance">AI has to earn its place.</h2>
        </div>
        <p class="measure text-body-lg text-graphite text-pretty md:col-span-5">
          Not every engagement needs AI. Each rung has prerequisites: data, evaluation, an owner,
          economics, failure handling, and a safe disable path. The diagnostic picks the lowest level
          that creates measurable value and names what the next one requires.
        </p>
      </div>

      <ol class="mt-12 grid border-t border-ink md:grid-cols-5">
        {
          maturityLadder.map((rung, i) => (
            <li class="flex flex-col gap-2 border-b border-line py-6 md:border-b-0 md:border-l md:px-5 md:first:border-l-0 md:first:pl-0">
              <span class="mono text-signal">{pad(i)}</span>
              <p class="text-body-lg font-semibold text-ink">{rung.stage}</p>
              <p class="text-body text-graphite">{rung.needs}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 9. Operational evidence -->
  <section class:list={[shell, "py-24 md:py-32"]}>
    <p class="mono text-signal">[ OPERATIONAL EVIDENCE ]</p>
    <h2 class="mt-3 max-w-[22ch] text-h2 text-ink text-balance">Evidence will replace promises.</h2>
    <p class="mt-6 measure text-body-lg text-graphite text-pretty">
      We publish measured outcomes when the work gives us evidence to publish. These are the eight
      operational metrics we baseline and track across engagements:
    </p>

    <ul class="mt-12 grid gap-px border border-line bg-line md:grid-cols-2 lg:grid-cols-4">
      {
        metrics.map((metric, i) => (
          <li class="flex min-h-36 flex-col justify-between gap-6 bg-surface p-5" data-evidence-item>
            <div class="flex items-center justify-between">
              <span class="mono text-graphite">M-{pad(i)}</span>
              <span class="mono text-signal">[ {metric.category} ]</span>
            </div>
            <span class="text-h3 text-ink text-balance">{metric.name}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 10. Qualification -->
  <section class="border-t border-line">
    <div class:list={[shell, "py-24 md:py-32"]}>
      <h2 class="max-w-[24ch] text-h2 text-ink text-balance">We work best when ownership is part of the brief.</h2>

      <div class="mt-12 grid gap-12 md:grid-cols-2 md:gap-8">
        <div>
          <h3 class="mono border-b border-ink pb-4 text-success">[ GOOD FIT ]</h3>
          <ul class="mt-6 flex flex-col gap-4">
            {
              goodFit.map((item) => (
                <li class="flex items-start gap-3 text-body-lg text-ink">
                  <Icon name="solar:check-circle-linear" class="mt-1 h-5 w-5 shrink-0 text-success" aria-hidden="true" />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="mono border-b border-ink pb-4 text-graphite">[ PROBABLY NOT A FIT ]</h3>
          <ul class="mt-6 flex flex-col gap-4">
            {
              notFit.map((item) => (
                <li class="flex items-start gap-3 text-body-lg text-graphite">
                  <Icon name="solar:close-circle-linear" class="mt-1 h-5 w-5 shrink-0 text-graphite" aria-hidden="true" />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 11. Final CTA -->
  <section class="border-t border-line bg-surface">
    <div class:list={[shell, "py-24 md:py-32"]}>
      <h2 class="max-w-[18ch] text-h1 text-ink text-balance">Own the next stage of your technology.</h2>
      <p class="mt-8 measure text-body-lg text-graphite text-pretty">
        Tell us where your systems, data, delivery, or internal capability are holding the business
        back. NewCo will tell you honestly whether a diagnostic is the right next step. No speculative
        estimate, and no obligation to continue afterward.
      </p>
      <div class="mt-10">
        <Button href="/contact" variant="primary" class={btn}>Discuss your situation</Button>
      </div>
    </div>
  </section>
</Layout>
