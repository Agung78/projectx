---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
---

<Layout
  title="Contact NewCo · Discuss Systems & Engineering Handover"
  description="Contact NewCo's founders to discuss your business systems, technical constraints, and path to full engineering independence."
>
  <section class="mx-auto max-w-[1200px] px-4 md:px-6 py-16 md:py-24">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-12">
      <div class="lg:sticky lg:top-28 lg:col-span-5 lg:self-start">
        <span class="mono text-blue">// ENGAGEMENT BRIEF</span>
        <h1 class="mt-6 text-h1 text-navy text-balance tracking-tight">Tell us what the business needs.</h1>
        <p class="text-body-lg text-slate max-w-[68ch] mt-6">
          Share a few details and we'll reply with a clear next step. No obligation, and we'll never ask for passwords or system access here.
        </p>

        <div class="mt-8 border-t border-line pt-6">
          <h2 class="text-sm font-semibold tracking-wide text-navy uppercase mono">// Direct Founder Review</h2>
          <p class="mt-2 text-body text-slate">Every enquiry is reviewed directly by our founders, Vanezza and Agung Denisa, with a guaranteed 24-hour response.</p>
          <h3 class="text-sm font-semibold tracking-wide text-navy uppercase mono mt-6">// What to expect</h3>
          <ul class="mt-3 flex flex-col gap-3 text-sm text-slate list-disc pl-4">
            <li>An initial 30-minute scoping call to understand your systems and constraints.</li>
            <li>Clear technical recommendations and capability baseline assessment.</li>
            <li>Honest fit evaluation: we only take on engagements where we can ensure complete handover.</li>
          </ul>
        </div>

        <p class="mt-6 text-sm text-grey">We respect your privacy. See our <a href="/privacy" class="underline hover:text-navy">Privacy Policy</a>.</p>
      </div>

      <div class="lg:col-span-7">
      <div class="rounded-xl border border-line bg-white p-6 shadow-sm md:p-8">
        <p class="mono mb-6 border-b border-line pb-4 text-grey">// INTAKE CONSOLE</p>
      <form
        id="contact-form"
        method="post"
        novalidate
        class="flex flex-col gap-8"
        data-contact-form
      >
        <div class="grid gap-6 md:grid-cols-2">
            <div class="flex flex-col gap-2">
                <label for="name" class="text-sm font-semibold text-slate">Your name<span aria-hidden="true"> *</span></label>
                <input id="name" name="name" type="text" required autocomplete="name"
                  class="rounded-[8px] border border-field bg-white px-4 py-3 text-body text-navy focus:border-blue focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
                  aria-describedby="name-error" />
                <p id="name-error" class="hidden text-body text-red" role="alert"></p>
              </div>
              <div class="flex flex-col gap-2">
                <label for="company" class="text-sm font-semibold text-slate">Company<span aria-hidden="true"> *</span></label>
                <input id="company" name="company" type="text" required autocomplete="organization"
                  class="rounded-[8px] border border-field bg-white px-4 py-3 text-body text-navy focus:border-blue focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
                  aria-describedby="company-error" />
                <p id="company-error" class="hidden text-body text-red" role="alert"></p>
              </div>
              <div class="flex flex-col gap-2">
                <label for="role" class="text-sm font-semibold text-slate">Your role<span aria-hidden="true"> *</span></label>
                <input id="role" name="role" type="text" required autocomplete="organization-title"
                  class="rounded-[8px] border border-field bg-white px-4 py-3 text-body text-navy focus:border-blue focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
                  aria-describedby="role-error" />
                <p id="role-error" class="hidden text-body text-red" role="alert"></p>
              </div>
              <div class="flex flex-col gap-2">
                <label for="email" class="text-sm font-semibold text-slate">Email<span aria-hidden="true"> *</span></label>
                <input id="email" name="email" type="email" required autocomplete="email"
                  class="rounded-[8px] border border-field bg-white px-4 py-3 text-body text-navy focus:border-blue focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
                  aria-describedby="email-error" />
                <p id="email-error" class="hidden text-body text-red" role="alert"></p>
              </div>
              <div class="flex flex-col gap-2">
                <label for="region" class="text-sm font-semibold text-slate">Country or region<span aria-hidden="true"> *</span></label>
                <input id="region" name="region" type="text" required autocomplete="country-name"
                  class="rounded-[8px] border border-field bg-white px-4 py-3 text-body text-navy focus:border-blue focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
                  aria-describedby="region-error" />
                <p id="region-error" class="hidden text-body text-red" role="alert"></p>
              </div>
              <div class="flex flex-col gap-2">
                <label for="locations" class="text-sm font-semibold text-slate">How many locations or branches?<span aria-hidden="true"> *</span></label>
                <input id="locations" name="locations" type="text" required
                  class="rounded-[8px] border border-field bg-white px-4 py-3 text-body text-navy focus:border-blue focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
                  aria-describedby="locations-error" />
                <p id="locations-error" class="hidden text-body text-red" role="alert"></p>
              </div>
        </div>

        <div class="flex flex-col gap-2">
          <label for="help" class="text-sm font-semibold text-slate">What would you like help with?<span aria-hidden="true"> *</span></label>
          <textarea id="help" name="help" required rows="4"
            class="rounded-[8px] border border-field bg-white px-4 py-3 text-body text-navy focus:border-blue focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
            aria-describedby="help-error"></textarea>
          <p id="help-error" class="hidden text-body text-red" role="alert"></p>
        </div>

        <fieldset class="flex flex-col gap-2" aria-describedby="follow_up-error">
          <legend class="text-sm font-semibold text-slate">How should we follow up?<span aria-hidden="true"> *</span></legend>
          <div class="flex flex-col gap-2 md:flex-row md:gap-6">
            {
              ["Email", "Phone", "Video call"].map((option) => (
                <label class="flex cursor-pointer items-center gap-2 rounded-full border border-field bg-white px-4 py-2 text-body text-navy has-[:checked]:border-blue has-[:checked]:bg-mist has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-blue">
                  <input type="radio" name="follow_up" value={option} required class="accent-blue" />
                  {option}
                </label>
              ))
            }
          </div>
          <p id="follow_up-error" class="hidden text-body text-red" role="alert"></p>
        </fieldset>

        <details class="rounded-lg border border-line bg-mist p-4" data-accordion>
          <summary class="cursor-pointer text-sm font-semibold text-navy">A bit more (optional)</summary>
          <div class="mt-4 grid gap-6 md:grid-cols-2" data-accordion-content>
              <div class="flex flex-col gap-2">
                <label for="project_type" class="text-sm font-semibold text-slate">What best describes the project?</label>
                <select id="project_type" name="project_type" class="rounded-[8px] border border-field bg-white px-4 py-3 text-body text-navy focus:border-blue focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue">
                  <option value="">Select one</option>
                  <option value="New system">New system</option>
                  <option value="Improve an existing system">Improve an existing system</option>
                  <option value="Not sure yet">Not sure yet</option>
                </select>
              </div>
              <div class="flex flex-col gap-2">
              <label for="decision_maker" class="text-sm font-semibold text-slate">Who's the main decision-maker?</label>
              <input id="decision_maker" name="decision_maker" type="text"
                class="rounded-[8px] border border-field bg-white px-4 py-3 text-body text-navy focus:border-blue focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue" />
              </div>
              <div class="flex flex-col gap-2">
              <label for="it_contact" class="text-sm font-semibold text-slate">Is there an IT contact or provider we should speak with?</label>
              <input id="it_contact" name="it_contact" type="text"
                class="rounded-[8px] border border-field bg-white px-4 py-3 text-body text-navy focus:border-blue focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue" />
              </div>
          </div>
        </details>

        <Button type="submit" variant="primary" class="mt-2 w-fit justify-center md:whitespace-nowrap" data-submit-button>
          <span data-button-label>Send</span>
        </Button>

      </form>
      <p data-form-status tabindex="-1" class="hidden text-body outline-offset-4" role="status"></p>
      </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  function initContactForm() {
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  if (form) {
    const submitButton = form.querySelector<HTMLButtonElement>("[data-submit-button]");
    const buttonLabel = form.querySelector<HTMLElement>("[data-button-label]");
    const status = document.querySelector<HTMLElement>("[data-form-status]");

    const requiredFields = Array.from(
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[required]")
    );

    const messages: Record<string, string> = {
      name: "Please enter your name",
      company: "Please add your company",
      role: "Please add your role",
      email: "Please add your email",
      region: "Please add your country or region",
      locations: "Please add how many locations or branches",
      help: "Please tell us what you'd like help with",
    };

    function showError(field: HTMLInputElement | HTMLTextAreaElement, message: string) {
      const errorId = field.getAttribute("aria-describedby");
      if (!errorId) return;
      const errorEl = document.getElementById(errorId);
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.classList.remove("hidden");
      }
      field.setAttribute("aria-invalid", "true");
    }

    function clearError(field: HTMLInputElement | HTMLTextAreaElement) {
      const errorId = field.getAttribute("aria-describedby");
      if (!errorId) return;
      const errorEl = document.getElementById(errorId);
      if (errorEl) {
        errorEl.textContent = "";
        errorEl.classList.add("hidden");
      }
      field.removeAttribute("aria-invalid");
    }

    function validateRadioGroup(): boolean {
      const checked = form?.querySelector<HTMLInputElement>('input[name="follow_up"]:checked');
      const errorEl = document.getElementById("follow_up-error");
      if (!checked && errorEl) {
        errorEl.textContent = "Please choose how we should follow up";
        errorEl.classList.remove("hidden");
        return false;
      }
      errorEl?.classList.add("hidden");
      return true;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      let valid = true;

      requiredFields.forEach((field) => {
        if (field.type === "radio") return;
        if (!field.value.trim()) {
          showError(field, messages[field.name] ?? "This field is required");
          valid = false;
        } else if (field.type === "email" && !/^\S+@\S+\.\S+$/.test(field.value)) {
          showError(field, "Please enter a valid email address");
          valid = false;
        } else {
          clearError(field);
        }
      });

      if (!validateRadioGroup()) valid = false;

      if (!valid) {
        form.querySelector<HTMLElement>('[aria-invalid="true"], input:invalid')?.focus();
        return;
      }

      if (submitButton && buttonLabel && status) {
        submitButton.disabled = true;
        buttonLabel.textContent = "Sending…";
        status.classList.add("hidden");

        await new Promise((resolve) => setTimeout(resolve, 600));

        form.hidden = true;
        status.classList.remove("hidden");
        status.innerHTML =
          "Thanks, we've got it. We'll reply within 24 hours with a clear next step.";
        status.classList.add("text-green", "text-body-lg", "font-semibold");
        requestAnimationFrame(() => {
          status.dataset.visible = "true";
          status.focus();
        });
      }
    });

    requiredFields.forEach((field) => {
      field.addEventListener("input", () => clearError(field));
    });
  }
  }

  function initAccordions() {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const DURATION = 260;
    const EASING = "cubic-bezier(0.23, 1, 0.32, 1)";

    document.querySelectorAll<HTMLDetailsElement>("details[data-accordion]").forEach((details) => {
      if (details.dataset.bound === "true") return;
      details.dataset.bound = "true";

      const summary = details.querySelector("summary");
      const content = details.querySelector<HTMLElement>("[data-accordion-content]");
      if (!summary || !content) return;
      let animation: Animation | null = null;

      const snapshot = () => {
        const style = getComputedStyle(content);
        return { height: style.height, opacity: style.opacity, marginTop: style.marginTop };
      };

      const run = (opening: boolean) => {
        // Capture the live values so a mid-animation toggle reverses from where it is.
        const from = animation
          ? snapshot()
          : opening
            ? { height: "0px", opacity: "0", marginTop: "0px" }
            : null;
        animation?.cancel();

        if (opening) {
          details.open = true;
          delete details.dataset.closing;
        } else {
          details.dataset.closing = "true";
        }

        const natural = snapshot();
        const collapsed = { height: "0px", opacity: "0", marginTop: "0px" };
        const start = from ?? natural;
        const end = opening ? natural : collapsed;

        content.style.overflow = "hidden";
        const current = content.animate([start, end], {
          duration: DURATION,
          easing: EASING,
          fill: "forwards",
        });
        animation = current;

        current.onfinish = () => {
          if (animation !== current) return;
          animation = null;
          if (!opening) {
            details.open = false;
            delete details.dataset.closing;
          }
          current.cancel();
          content.style.overflow = "";
        };
        // A cancelled animation was superseded by a newer toggle, which owns cleanup.
      };

      summary.addEventListener("click", (event) => {
        if (reducedMotion.matches) {
          delete details.dataset.closing;
          return;
        }
        event.preventDefault();
        const isOpen = details.open && !details.dataset.closing;
        run(!isOpen);
      });
    });
  }

  document.addEventListener("astro:page-load", initContactForm);
  document.addEventListener("astro:page-load", initAccordions);
</script>
