---
import Layout from "../layouts/Layout.astro";
import CapabilityCurve from "../components/CapabilityCurve.astro";
import { pad, shell } from "../lib/ui";

const stages = [
  {
    name: "Discovery",
    nameKey: "howwework.stages.discovery.name",
    body: "We conduct a thorough audit of your current applications, infrastructure, and engineering workflows. Together, we map technical debt, identify security risks, and agree on an unambiguous architectural blueprint.",
    bodyKey: "howwework.stages.discovery.body",
    gets: "a comprehensive technical roadmap with architecture designs, concrete milestones, and transparent cost estimates.",
    getsKey: "howwework.stages.discovery.gets",
  },
  {
    name: "Development",
    nameKey: "howwework.stages.development.name",
    body: "Our engineers build alongside your team using modern TypeScript, strict testing, and clean architecture. We host regular sprint demos so your stakeholders can validate working software as it evolves.",
    bodyKey: "howwework.stages.development.body",
    gets: "a production-grade system with automated test suites, continuous deployment, and clean code documentation.",
    getsKey: "howwework.stages.development.gets",
  },
  {
    name: "Operations and Support",
    nameKey: "howwework.stages.operations.name",
    body: "Following deployment, we configure observability dashboards, uptime health checks, and automated alerting. We share on-call duties to resolve incidents fast and tune infrastructure performance.",
    bodyKey: "howwework.stages.operations.body",
    gets: "a resilient, production-hardened platform backed by agreed-upon response SLAs and real-time monitoring.",
    getsKey: "howwework.stages.operations.gets",
  },
  {
    name: "Ownership Transfer",
    nameKey: "howwework.stages.transfer.name",
    body: "We walk through every codebase, cloud account, access credential, and runbook with your engineers. We do not conclude our engagement until your team operates the platform with complete autonomy.",
    bodyKey: "howwework.stages.transfer.body",
    gets: "complete autonomous ownership of your technical infrastructure, with zero ongoing dependency on us.",
    getsKey: "howwework.stages.transfer.gets",
  },
];

const howWeWorkStages = [
  { label: "Discovery", labelKey: "howwework.curve.discovery.label", newco: 90, client: 10, pager: 100, milestone: "Baseline Diagnostic", milestoneKey: "howwework.curve.discovery.milestone" },
  { label: "Development", labelKey: "howwework.curve.development.label", newco: 70, client: 35, pager: 75, milestone: "Joint Engineering", milestoneKey: "howwework.curve.development.milestone" },
  { label: "Operations and Support", labelKey: "howwework.curve.operations.label", newco: 40, client: 65, pager: 40, milestone: "Shared Operations", milestoneKey: "howwework.curve.operations.milestone" },
  { label: "Ownership Transfer", labelKey: "howwework.curve.transfer.label", newco: 10, client: 90, pager: 0, milestone: "Autonomous Ownership", milestoneKey: "howwework.curve.transfer.milestone" },
];

const handover = [
  { item: "Source code", itemKey: "howwework.handover.source-code.item", included: "Every line, stored in the business's own account", includedKey: "howwework.handover.source-code.included" },
  { item: "Documentation", itemKey: "howwework.handover.documentation.item", included: "How the system works, written in plain language", includedKey: "howwework.handover.documentation.included" },
  { item: "Accounts and access", itemKey: "howwework.handover.accounts.item", included: "Hosting, domains and services in the business's name", includedKey: "howwework.handover.accounts.included" },
  { item: "Running guides", itemKey: "howwework.handover.guides.item", included: "Step-by-step instructions for everyday tasks and updates", includedKey: "howwework.handover.guides.included" },
  { item: "Recovery plan", itemKey: "howwework.handover.recovery.item", included: "How to restore the system from backup if something goes wrong", includedKey: "howwework.handover.recovery.included" },
  { item: "Security review", itemKey: "howwework.handover.security.item", included: "Passwords changed and access checked before sign-off", includedKey: "howwework.handover.security.included" },
  { item: "Live walkthrough", itemKey: "howwework.handover.walkthrough.item", included: "A guided session with whoever takes over", includedKey: "howwework.handover.walkthrough.included" },
  { item: "Ongoing support", itemKey: "howwework.handover.support.item", included: "Available from us if the business wants it, never required", includedKey: "howwework.handover.support.included" },
];

const technologies = [
  {
    name: "Astro",
    icon: "/images/tech/astro.svg",
    wordmark: true,
  },
  {
    name: "Next.js",
    icon: "/images/tech/nextdotjs.svg",
  },
  {
    name: "Vue",
    icon: "/images/tech/vuedotjs.svg",
  },
  {
    name: "Vite",
    icon: "/images/tech/vite.svg",
  },
  {
    name: "Tailwind CSS",
    icon: "/images/tech/tailwindcss.svg",
  },
  {
    name: "Bootstrap",
    icon: "/images/tech/bootstrap.svg",
  },
  {
    name: "Node.js",
    icon: "/images/tech/nodedotjs.svg",
  },
  {
    name: "NestJS",
    icon: "/images/tech/nestjs.svg",
  },
  {
    name: "Fastify",
    icon: "/images/tech/fastify.svg",
  },
  {
    name: "Express.js",
    icon: "/images/tech/express.svg",
  },
  {
    name: "PostgreSQL",
    icon: "/images/tech/postgresql.svg",
  },
  {
    name: "Supabase",
    icon: "/images/tech/supabase.svg",
  },
  {
    name: "Neon",
    icon: "/images/tech/neon.svg",
  },
  {
    name: "Snowflake",
    icon: "/images/tech/snowflake.svg",
  },
  {
    name: "BigQuery",
    icon: "/images/tech/googlebigquery.svg",
  },
  {
    name: "Google Cloud",
    icon: "/images/tech/googlecloud.svg",
  },
  {
    name: "Cloudflare",
    icon: "/images/tech/cloudflare.svg",
  },
  {
    name: "Render",
    icon: "/images/tech/render.svg",
  },
  {
    name: "Railway",
    icon: "/images/tech/railway.svg",
  },
  {
    name: "Docker",
    icon: "/images/tech/docker.svg",
  },
  {
    name: "Snyk",
    icon: "/images/tech/snyk.svg",
  },
  {
    name: "Semgrep",
    icon: "/images/tech/semgrep.svg",
  },
  {
    name: "Veracode",
    icon: "/images/tech/veracode.svg",
    wordmark: true,
  },
  {
    name: "Strix AI",
    icon: "/images/tech/strix.png",
  },
  {
    name: "Claude",
    icon: "/images/tech/claude.svg",
  },
  {
    name: "Gemini",
    icon: "/images/tech/gemini.svg",
  },
  {
    name: "ChatGPT",
    icon: "/images/tech/chatgpt.svg",
  },
  {
    name: "DeepSeek",
    icon: "/images/tech/deepseek.svg",
