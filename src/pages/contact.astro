---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
---

<Layout
  title="Discuss Your Engineering Situation | NewCo"
  description="Schedule an introductory scoping discussion with NewCo. We review your multi-location operational constraints and recommend clear next steps."
>
  <section class="mx-auto max-w-content px-[clamp(20px,5vw,80px)] py-16 md:pt-20 md:pb-24">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="mono text-signal">[ QUALIFICATION &amp; CONTACT ]</p>
        <h1 class="mt-6 text-h1 text-ink text-balance tracking-tight">Discuss your engineering situation.</h1>
        <p class="mt-8 measure text-body-lg text-graphite">
          Tell us about your multi-location systems, technical constraints, and current bottlenecks. We evaluate every
          inquiry against our fit criteria and outline the most effective next step for your business.
        </p>
        <p class="mt-4 measure text-body text-graphite">
          Introductory consultations are exploratory and confidential. We never request credentials or sensitive system access through web inquiries.
        </p>
      </div>

      <div class="md:col-span-7">
        <form
          id="contact-form"
          method="post"
          novalidate
          class="flex flex-col gap-6 border border-ink bg-surface p-5 md:p-8"
          data-contact-form
        >
          <div class="grid gap-6 md:grid-cols-2">
            <div class="flex flex-col gap-2">
              <label for="name" class="mono text-graphite">Name<span aria-hidden="true"> *</span></label>
              <input id="name" name="name" type="text" required autocomplete="name"
                class="border border-line bg-surface px-4 py-3 text-body text-ink focus:border-signal focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal"
                aria-describedby="name-error" />
              <p id="name-error" class="hidden text-body text-error" role="alert"></p>
            </div>

            <div class="flex flex-col gap-2">
              <label for="company" class="mono text-graphite">Company<span aria-hidden="true"> *</span></label>
              <input id="company" name="company" type="text" required autocomplete="organization"
                class="border border-line bg-surface px-4 py-3 text-body text-ink focus:border-signal focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal"
                aria-describedby="company-error" />
              <p id="company-error" class="hidden text-body text-error" role="alert"></p>
            </div>

            <div class="flex flex-col gap-2">
              <label for="role" class="mono text-graphite">Role<span aria-hidden="true"> *</span></label>
              <input id="role" name="role" type="text" required autocomplete="organization-title"
                class="border border-line bg-surface px-4 py-3 text-body text-ink focus:border-signal focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal"
                aria-describedby="role-error" />
              <p id="role-error" class="hidden text-body text-error" role="alert"></p>
            </div>

            <div class="flex flex-col gap-2">
              <label for="email" class="mono text-graphite">Email<span aria-hidden="true"> *</span></label>
              <input id="email" name="email" type="email" required autocomplete="email"
                class="border border-line bg-surface px-4 py-3 text-body text-ink focus:border-signal focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal"
                aria-describedby="email-error" />
              <p id="email-error" class="hidden text-body text-error" role="alert"></p>
            </div>

            <div class="flex flex-col gap-2">
              <label for="region" class="mono text-graphite">Country / operating region<span aria-hidden="true"> *</span></label>
              <input id="region" name="region" type="text" required autocomplete="country-name"
                class="border border-line bg-surface px-4 py-3 text-body text-ink focus:border-signal focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal"
                aria-describedby="region-error" />
              <p id="region-error" class="hidden text-body text-error" role="alert"></p>
            </div>

            <div class="flex flex-col gap-2">
              <label for="locations" class="mono text-graphite">Approximate locations or operating units<span aria-hidden="true"> *</span></label>
              <input id="locations" name="locations" type="text" required
                class="border border-line bg-surface px-4 py-3 text-body text-ink focus:border-signal focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal"
                aria-describedby="locations-error" />
              <p id="locations-error" class="hidden text-body text-error" role="alert"></p>
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <label for="constraint" class="mono text-graphite">Current constraint<span aria-hidden="true"> *</span></label>
            <textarea id="constraint" name="constraint" required rows="4"
              class="border border-line bg-surface px-4 py-3 text-body text-ink focus:border-signal focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal"
              aria-describedby="constraint-error"></textarea>
            <p id="constraint-error" class="hidden text-body text-error" role="alert"></p>
          </div>

          <fieldset class="flex flex-col gap-2">
            <legend class="mono text-graphite">Preferred way to continue<span aria-hidden="true"> *</span></legend>
            <div class="flex flex-col gap-2 md:flex-row md:gap-6">
              {
                ["Email", "Call", "Video call"].map((option) => (
                  <label class="flex items-center gap-2 text-body text-ink">
                    <input type="radio" name="preferred_contact" value={option} required class="accent-signal" />
                    {option}
                  </label>
                ))
              }
            </div>
            <p id="preferred_contact-error" class="hidden text-body text-error" role="alert"></p>
          </fieldset>

          <details class="border border-line bg-surface p-4">
            <summary class="mono cursor-pointer text-ink">[ Optional qualification details ]</summary>
            <div class="mt-4 grid gap-6 md:grid-cols-2">
              <div class="flex flex-col gap-2">
                <label for="technical_counterpart" class="mono text-graphite">Technical counterpart</label>
                <input id="technical_counterpart" name="technical_counterpart" type="text"
                  class="border border-line bg-canvas px-4 py-3 text-body text-ink focus:border-signal focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal" />
              </div>
              <div class="flex flex-col gap-2">
                <label for="executive_sponsor" class="mono text-graphite">Executive sponsor</label>
                <input id="executive_sponsor" name="executive_sponsor" type="text"
                  class="border border-line bg-canvas px-4 py-3 text-body text-ink focus:border-signal focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal" />
              </div>
              <div class="flex flex-col gap-2 md:col-span-2">
                <label for="primary_situation" class="mono text-graphite">Primary situation</label>
                <textarea id="primary_situation" name="primary_situation" rows="3"
                  class="border border-line bg-canvas px-4 py-3 text-body text-ink focus:border-signal focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal"></textarea>
              </div>
            </div>
          </details>

          <Button type="submit" variant="primary" class="mt-2 w-fit justify-center md:whitespace-nowrap" data-submit-button>
            <span data-button-label>Send my situation</span>
          </Button>

          <p data-form-status class="hidden text-body" role="status"></p>
        </form>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-content px-[clamp(20px,5vw,80px)] pb-24">
    <div class="grid gap-12 border-t border-line pt-16 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="mono text-signal">[ WHAT TO EXPECT ]</p>
        <h2 class="mt-6 text-h2 text-ink text-balance tracking-tight">What happens after you write to us.</h2>
      </div>
      <div class="flex flex-col gap-12 md:col-span-7">
        <div>
          <h3 class="text-h3 text-ink">What to expect</h3>
          <p class="mt-4 measure text-body text-graphite">
            A founder reads every request personally. We compare what you describe against the situations we know
            how to help with, and we reply by email with a recommended next step. That step might be a conversation,
            a scoped diagnostic, a pointer to a better-suited partner, or a plain statement that we are not the right
            fit. You will never be passed to a sales queue or asked to sit through a generic presentation.
          </p>
          <p class="mt-4 measure text-body text-graphite">
            The more specific you are about the constraint you are facing, the more useful our reply will be. Tell us
            what is slowing your engineering team down, what has already been tried, and what a good outcome looks
            like twelve months from now.
          </p>
        </div>

        <div>
          <h3 class="text-h3 text-ink">Fit criteria</h3>
          <p class="mt-4 measure text-body text-graphite">
            We work best with organisations that want to own their engineering capability rather than rent it
            indefinitely. In practice, that means a few things:
          </p>
          <ul class="mt-4 measure list-disc pl-5 text-body text-graphite">
            <li>You have a technical counterpart who can work alongside us day to day.</li>
            <li>An executive sponsor is willing to make decisions about priorities and trade-offs.</li>
            <li>The constraint is real and specific, such as architecture, delivery speed, reliability or hiring.</li>
            <li>You are prepared to measure progress against a scorecard and to take over the work by the end.</li>
          </ul>
          <p class="mt-4 measure text-body text-graphite">
            We decline work where the goal is permanent outsourcing, where there is no sponsor with authority, or
            where the request is for staff augmentation under another name. Saying no early saves everyone time.
          </p>
        </div>

        <div>
          <h3 class="text-h3 text-ink">Consultation timeline</h3>
          <p class="mt-4 measure text-body text-graphite">
            Within two business days you will receive a reply confirming whether your request matches our criteria.
            If it does, we schedule an introductory conversation of around forty-five minutes, usually within the
            following week, to understand your systems, your team and your goals in more detail.
          </p>
          <p class="mt-4 measure text-body text-graphite">
            After that conversation we send a short written recommendation. If a technical diagnostic is the right
            starting point, the recommendation includes scope, fixed fee and dates. There is no obligation at any
            stage, and we never ask for credentials or production access through this form.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  if (form) {
    const submitButton = form.querySelector<HTMLButtonElement>("[data-submit-button]");
    const buttonLabel = form.querySelector<HTMLElement>("[data-button-label]");
    const status = form.querySelector<HTMLElement>("[data-form-status]");

    const requiredFields = Array.from(
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[required]")
    );

    function showError(field: HTMLInputElement | HTMLTextAreaElement, message: string) {
      const errorId = field.getAttribute("aria-describedby");
      if (!errorId) return;
      const errorEl = document.getElementById(errorId);
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.classList.remove("hidden");
      }
      field.setAttribute("aria-invalid", "true");
    }

    function clearError(field: HTMLInputElement | HTMLTextAreaElement) {
      const errorId = field.getAttribute("aria-describedby");
      if (!errorId) return;
      const errorEl = document.getElementById(errorId);
      if (errorEl) {
        errorEl.textContent = "";
        errorEl.classList.add("hidden");
      }
      field.removeAttribute("aria-invalid");
    }

    function validateRadioGroup(): boolean {
      const checked = form?.querySelector<HTMLInputElement>('input[name="preferred_contact"]:checked');
      const errorEl = document.getElementById("preferred_contact-error");
      if (!checked && errorEl) {
        errorEl.textContent = "Choose a preferred way to continue.";
        errorEl.classList.remove("hidden");
        return false;
      }
      errorEl?.classList.add("hidden");
      return true;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      let valid = true;

      requiredFields.forEach((field) => {
        if (field.type === "radio") return;
        if (!field.value.trim()) {
          showError(field, "This field is required.");
          valid = false;
        } else if (field.type === "email" && !/^\S+@\S+\.\S+$/.test(field.value)) {
          showError(field, "Enter a valid email address.");
          valid = false;
        } else {
          clearError(field);
        }
      });

      if (!validateRadioGroup()) valid = false;

      if (!valid) {
        form.querySelector<HTMLElement>('[aria-invalid="true"], input:invalid')?.focus();
        return;
      }

      if (submitButton && buttonLabel && status) {
        submitButton.disabled = true;
        buttonLabel.textContent = "Sending…";
        status.classList.add("hidden");

        await new Promise((resolve) => setTimeout(resolve, 600));

        form.hidden = true;
        status.classList.remove("hidden");
        status.innerHTML =
          "Sent. We review every request against our fit criteria and will reply by email with a recommended next step.";
        status.classList.add("text-success", "text-body-lg", "font-medium");
        requestAnimationFrame(() => {
          status.dataset.visible = "true";
        });
      }
    });

    requiredFields.forEach((field) => {
      field.addEventListener("input", () => clearError(field));
    });
  }
</script>
