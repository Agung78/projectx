---

<Layout
  titleKey="meta.howwework.title"
  descKey="meta.howwework.description"
  lcpImage="/images/tech/astro.svg"
>
  <section class="bg-white">
    <div class:list={[shell, "py-16 md:py-24"]}>
      <span class="mono text-blue" data-i18n="howwework.hero.eyebrow">// METHODOLOGY &amp; PROCESS</span>
      <div class="mt-6 grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12">
        <h1 class="text-h1 uppercase text-navy text-balance tracking-tight lg:col-span-7" data-i18n="howwework.hero.title">One clear process, start to finish.</h1>
        <p class="text-body-lg text-slate text-pretty lg:col-span-5 lg:pt-2" data-i18n="howwework.hero.lede">
          We work alongside the business at every stage, and it always has the final say. Every decision is explained in
          plain language, with no jargon.
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-mist py-16 md:py-24">
    <div class={shell}>
      <h2 class="text-h2 text-navy text-balance" data-i18n="howwework.stages.heading">Four stages, one direction.</h2>
      <div class="mt-12 grid grid-cols-1 overflow-hidden rounded-xl border border-line bg-white md:grid-cols-2 lg:grid-cols-4">
        {
          stages.map((stage, i) => (
            <div class="flex flex-col justify-between border-t border-line p-6 first:border-t-0 md:nth-2:border-t-0 md:odd:border-r md:p-8 lg:border-t-0 lg:border-r lg:last:border-r-0">
              <div>
                <span class="mono text-blue"><span data-i18n="howwework.stages.step-prefix">STEP //</span> {pad(i)}</span>
                <p class="mt-4 text-[2.5rem] font-semibold leading-none text-navy/15" aria-hidden="true">{pad(i)}</p>
                <h3 class="mt-4 text-h3 text-navy" data-i18n={stage.nameKey}>{stage.name}</h3>
                <p class="mt-3 text-grey" data-i18n={stage.bodyKey}>{stage.body}</p>
              </div>
              <p class="mt-6 border border-line bg-mist px-3 py-2 text-sm text-navy">
                <span class="font-semibold" data-i18n="howwework.stages.gets-label">The business gets:</span> <span data-i18n={stage.getsKey}>{stage.gets}</span>
              </p>
            </div>
          ))
        }
      </div>
      <p class="mt-8 text-sm text-grey" data-i18n="howwework.stages.note">
        How long each stage takes depends on the project. We agree the timeline during Discovery.
      </p>
      <div class="mt-16">
        <div class="corners rounded-xl border border-line bg-white p-3 md:p-6">
          <div class="mb-4 flex items-center justify-between border-b border-line pb-3">
            <span class="mono text-grey" data-i18n="howwework.curve.fig">// FIG. 01</span>
            <span class="mono text-grey" data-i18n="howwework.curve.title">OWNERSHIP CURVE</span>
          </div>
          <CapabilityCurve
            phases={howWeWorkStages}
            caption="By the final stage, the business runs its technology on its own terms."
            captionKey="howwework.curve.caption"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 md:py-24">
    <div class={shell}>
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:sticky lg:top-28 lg:col-span-5 lg:self-start">
          <span class="mono text-grey" data-i18n="howwework.handover.eyebrow">// HANDOVER CHECKLIST</span>
          <h2 class="mt-4 text-h2 text-navy text-balance" data-i18n="howwework.handover.heading">Everything handed over, nothing held back.</h2>
          <p class="text-body-lg text-slate max-w-[68ch] mt-4" data-i18n="howwework.handover.lede">
            Before we sign off, each item below is delivered and walked through with whoever will run the system. The
            checklist is agreed in the contract.
          </p>
        </div>

        <div class="corners overflow-hidden rounded-xl border border-line bg-white lg:col-span-7">
          <table class="w-full text-left border-collapse">
            <caption class="sr-only" data-i18n="howwework.handover.caption">Detailed technical handover deliverables, source repository ownership, and transition milestones</caption>
            <thead>
              <tr class="border-b border-line bg-mist">
                <th scope="col" class="mono px-4 py-4 text-navy md:px-6" data-i18n="howwework.handover.col-item">Item</th>
                <th scope="col" class="mono px-4 py-4 text-navy md:px-6" data-i18n="howwework.handover.col-included">What's included</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              {
                handover.map((row, i) => (
                  <tr>
                    <th scope="row" class="px-4 py-4 align-top font-bold text-navy md:px-6">
                      <span class="mono mr-2 text-blue">{pad(i)}</span><span data-i18n={row.itemKey}>{row.item}</span>
                    </th>
                    <td class="px-4 py-4 text-slate md:px-6" data-i18n={row.includedKey}>{row.included}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-mist py-16 md:py-20" aria-labelledby="tech-note">
    <div class={shell}>
      <p id="tech-note" class="mono text-grey" data-i18n="howwework.tech.note">// Built on proven, widely used technology.</p>
      <p class="mt-3 max-w-[70ch] text-body text-slate" data-i18n="howwework.tech.lede">
        We deliberately select battle-tested, widely adopted open-source technologies with robust global communities. This ensures any qualified software engineer can comfortably inspect, maintain, and expand your systems without specialized proprietary training.
      </p>
    </div>
    <div class="marquee mt-10 md:mt-12" aria-label="Technologies we build with" data-i18n-attr="aria-label:howwework.tech.aria">
      {
        marqueeRows.map((row, r) => (
          <ul class={`marquee-track marquee-track-${row.direction}`}>
            {row.items.map((tech, i) => (
              <li class="marquee-badge">
                <img
                  src={tech.icon}
                  alt={tech.wordmark ? tech.name : ""}
                  width="24"
                  height="24"
                  class="h-6 w-auto shrink-0 object-contain"
                  loading={r === 0 && i < 4 ? "eager" : "lazy"}
                  fetchpriority={r === 0 && i === 0 ? "high" : "auto"}
                  decoding="async"
                />
                {!tech.wordmark && <span>{tech.name}</span>}
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </section>

  <section class="border-t border-line bg-white py-16 md:py-24">
    <div class={shell}>
      <div class="max-w-[72ch]">
        <span class="mono text-blue" data-i18n="howwework.governance.eyebrow">// ENGINEERING GOVERNANCE</span>
        <h2 class="mt-4 text-h2 text-navy text-balance" data-i18n="howwework.governance.heading">Reliable systems need shared standards, not secret knowledge.</h2>
        <p class="mt-4 text-body-lg text-slate" data-i18n="howwework.governance.lede">
          When engineering teams depend on heroics or tribal memory, software degrades with every release. We build repeatable processes into the codebase itself.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3 lg:items-stretch">
        <div class="corners flex h-full flex-col rounded-xl border border-line bg-mist p-6 transition-colors duration-200 hover:border-navy/30 hover:bg-white md:p-8">
          <Icon name="solar:checklist-minimalistic-linear" class="h-9 w-9 text-blue" aria-hidden="true" />
          <p class="mono mt-6 text-grey" aria-hidden="true">01</p>
          <h3 class="mt-2 text-h3 font-semibold text-navy" data-i18n="howwework.governance.test-title">Automated testing &amp; CI/CD</h3>
          <p class="mt-3 text-body text-slate" data-i18n="howwework.governance.test-body">
            Every pull request triggers automated unit, integration, and security checks before merging. Deployments run through reproducible, automated pipelines with zero downtime and rollback triggers.
          </p>
        </div>
        <div class="corners flex h-full flex-col rounded-xl border border-line bg-mist p-6 transition-colors duration-200 hover:border-navy/30 hover:bg-white md:p-8">
          <Icon name="solar:chart-linear" class="h-9 w-9 text-blue" aria-hidden="true" />
          <p class="mono mt-6 text-grey" aria-hidden="true">02</p>
          <h3 class="mt-2 text-h3 font-semibold text-navy" data-i18n="howwework.governance.obs-title">Observability &amp; runbooks</h3>
          <p class="mt-3 text-body text-slate" data-i18n="howwework.governance.obs-body">
            Structured logging, metrics, and actionable alerts mean issues are spotted before users notice them. Every critical alert links directly to a plain-language operational runbook.
          </p>
        </div>
        <div class="corners flex h-full flex-col rounded-xl border border-line bg-mist p-6 transition-colors duration-200 hover:border-navy/30 hover:bg-white md:p-8 md:col-span-2 lg:col-span-1">
          <Icon name="solar:cloud-file-linear" class="h-9 w-9 text-blue" aria-hidden="true" />
          <p class="mono mt-6 text-grey" aria-hidden="true">03</p>
          <h3 class="mt-2 text-h3 font-semibold text-navy" data-i18n="howwework.governance.infra-title">Infrastructure as code</h3>
          <p class="mt-3 text-body text-slate" data-i18n="howwework.governance.infra-body">
            Cloud resources, databases, networking, and access policies are defined declaratively in version control. Staging mirrors production, eliminating surprise deployment discrepancies.
          </p>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .marquee {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee-badge {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.625rem;
    border-radius: 0.75rem;
    border: 1px solid var(--color-line);
    background-color: #fff;
    padding: 0.625rem 1rem;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: var(--color-navy);
    box-shadow: 0 1px 2px 0 rgb(15 23 42 / 0.06);
    transition: border-color 150ms ease, box-shadow 150ms ease, transform 150ms ease;
  }
  .marquee-badge:hover {
    border-color: rgba(37, 99, 235, 0.5);
    box-shadow: 0 4px 12px -4px rgb(15 23 42 / 0.15);
    transform: translateY(-1px);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    max-width: max-content;
    gap: 0;
    padding: 0.35rem 0;
    padding-right: 1rem;
  }
  .marquee-track > .marquee-badge {
    margin-right: 1rem;
  }
  .marquee-track-left[data-cloned] {
    animation: marquee-left 40s linear infinite;
  }
  .marquee-track-right[data-cloned] {
    animation: marquee-right 46s linear infinite;
  }
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }
  @keyframes marquee-left {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @keyframes marquee-right {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      mask-image: none;
      -webkit-mask-image: none;
      overflow-x: auto;
    }
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
      width: 100%;
      max-width: 100%;
    }
  }
</style>

<script>
  // Seamless loop needs a second copy of each track; clone client-side so the
  // SSR HTML carries each badge once (text/HTML ratio, crawl weight).
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>(".marquee-track:not([data-cloned])").forEach((track) => {
      track.dataset.cloned = "";
      [...track.children].forEach((li) => {
        const copy = li.cloneNode(true) as HTMLElement;
        copy.setAttribute("aria-hidden", "true");
        copy.querySelectorAll("img").forEach((img) => (img.loading = "lazy"));
        track.append(copy);
      });
    });
  });
</script>
