---
/*
 * §7 Capability-Transfer Scorecard. One source for the eight capabilities and
 * four checkpoints so the home page and /approach never drift apart.
 */
interface Props {
  tone?: "dark" | "light";
}

const { tone = "light" } = Astro.props;
const dark = tone === "dark";

const scorecard = [
  { capability: "Architecture", evidence: "Explains the major components, constraints, and trade-offs." },
  { capability: "Delivery", evidence: "Ships a production change through the normal controls." },
  { capability: "Operations", evidence: "Responds to an incident using logs, metrics, traces, and runbooks." },
  { capability: "Recovery", evidence: "Executes rollback and recovery procedures." },
  { capability: "Data", evidence: "Validates freshness, quality, lineage, and permissions." },
  { capability: "Security", evidence: "Remediates a dependency or access-control issue." },
  { capability: "Decision-making", evidence: "Authors and defends an architecture decision record." },
  { capability: "Planning", evidence: "Prioritises and delivers the next iteration without us." },
];

const checkpoints = ["Baseline", "Build With", "Before shared ops", "Handover"];

const c = dark
  ? { head: "text-canvas/60", rule: "border-canvas/30", row: "border-canvas/15", name: "text-canvas", body: "text-canvas/80", dot: "border-canvas/40" }
  : { head: "text-graphite", rule: "border-ink", row: "border-line", name: "text-ink", body: "text-graphite", dot: "border-graphite/50" };
---

<table class="w-full border-collapse text-left">
  <caption class="sr-only">
    Capability-transfer scorecard: each capability, its handover evidence, and the four assessment checkpoints.
  </caption>
  <thead class="hidden md:table-header-group">
    <tr class:list={["border-b", c.rule]}>
      <th scope="col" class:list={["label w-[22%] py-4 pr-6", c.head]}>Capability</th>
      <th scope="col" class:list={["label py-4 pr-6", c.head]}>Evidence at handover</th>
      {
        checkpoints.map((checkpoint) => (
          <th scope="col" class:list={["label w-[9%] px-2 py-4 text-center", c.head]}>
            {checkpoint}
          </th>
        ))
      }
    </tr>
  </thead>
  <tbody>
    {
      scorecard.map((row) => (
        <tr class:list={["flex flex-col gap-1 border-b py-5 md:table-row md:py-0", c.row]}>
          <th scope="row" class:list={["text-h3 font-semibold md:py-6 md:pr-6", c.name]}>
            {row.capability}
          </th>
          <td class:list={["text-body-lg md:py-6 md:pr-6", c.body]}>{row.evidence}</td>
          {checkpoints.map((checkpoint, i) => (
            <td class="hidden px-2 text-center md:table-cell">
              <span
                class:list={[
                  "inline-block h-4 w-4 rounded-full border",
                  i === checkpoints.length - 1 ? "border-2 border-signal" : c.dot,
                ]}
              />
              <span class="sr-only">{checkpoint}: assessed</span>
            </td>
          ))}
        </tr>
      ))
    }
  </tbody>
</table>
