---
const navLinks = [
  { href: "/how-we-work", label: "How we work", key: "nav.how-we-work" },
  { href: "/about", label: "About", key: "nav.about" },
  { href: "/contact", label: "Contact", key: "nav.contact" },
];

const currentPath = Astro.url.pathname;
const enPath = currentPath.replace(/^\/id(?=\/|$)/, "") || "/";
// Absolute hrefs: middleware only rewrites root-relative ones, so these stay put.
const langHref = {
  en: new URL(enPath, Astro.site).href,
  id: new URL(`/id${enPath === "/" ? "/" : enPath}`, Astro.site).href,
};
---

<header
  transition:persist
  class="group/header sticky top-0 z-50 bg-white border-b border-transparent data-[stuck=true]:border-line transition-[background-color,border-color] duration-200"
  data-site-header
>
  <div class="mx-auto flex max-w-[1200px] items-center justify-between px-4 md:px-6 py-4">
    <a href="/" class="text-h3 font-semibold tracking-tight text-navy" aria-label="Kyron Engineering, home">
      Kyron Engineering
    </a>

    <div class="flex items-center justify-end gap-4 md:gap-6">
      <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="nav-link relative text-body text-grey transition-colors hover:text-navy aria-[current=page]:text-navy aria-[current=page]:font-semibold"
              aria-current={currentPath === link.href ? "page" : undefined}
              data-i18n={link.key}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="relative hidden items-center rounded-sm border border-line p-0.5 text-sm font-semibold md:inline-flex" role="group" aria-label="Language">
        <span
          class="pointer-events-none absolute inset-y-0.5 left-0.5 w-[calc(50%-2px)] rounded-xs bg-mist transition-transform duration-200 ease-out motion-reduce:transition-none"
          style="transform: translateX(0%)"
          data-lang-indicator
          aria-hidden="true"
        />
        <a href={langHref.en} hreflang="en" data-astro-reload data-lang-toggle data-lang="en" aria-current={currentPath.startsWith("/id") === (false) ? "true" : undefined} class="relative z-10 w-9 py-1 text-center transition-colors duration-150 text-navy cursor-pointer motion-reduce:transition-none">EN</a>
        <a href={langHref.id} hreflang="id" data-astro-reload data-lang-toggle data-lang="id" aria-current={currentPath.startsWith("/id") === (true) ? "true" : undefined} class="relative z-10 w-9 py-1 text-center transition-colors duration-150 text-grey hover:text-navy cursor-pointer motion-reduce:transition-none">ID</a>
      </div>

      <button
        type="button"
        class="pressable flex h-11 w-11 items-center justify-center rounded-sm border border-line md:hidden"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="sr-only">Open menu</span>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" hidden class="border-t border-line bg-white md:hidden" data-mobile-nav data-open="false">
    <nav class="flex flex-col gap-1 px-4 md:px-6 py-4" aria-label="Primary">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-sm px-2 py-3 text-body-lg text-navy"
            aria-current={currentPath === link.href ? "page" : undefined}
            data-i18n={link.key}
          >
            {link.label}
          </a>
        ))
      }
      <div class="px-2 py-3">
        <div class="relative inline-flex items-center rounded-sm border border-line p-0.5 text-sm font-semibold" role="group" aria-label="Language">
          <span
            class="pointer-events-none absolute inset-y-0.5 left-0.5 w-[calc(50%-2px)] rounded-xs bg-mist transition-transform duration-200 ease-out motion-reduce:transition-none"
            style="transform: translateX(0%)"
            data-lang-indicator
            aria-hidden="true"
          />
          <a href={langHref.en} hreflang="en" data-astro-reload data-lang-toggle data-lang="en" aria-current={currentPath.startsWith("/id") === (false) ? "true" : undefined} class="relative z-10 w-9 py-1 text-center transition-colors duration-150 text-navy cursor-pointer motion-reduce:transition-none">EN</a>
          <a href={langHref.id} hreflang="id" data-astro-reload data-lang-toggle data-lang="id" aria-current={currentPath.startsWith("/id") === (true) ? "true" : undefined} class="relative z-10 w-9 py-1 text-center transition-colors duration-150 text-grey hover:text-navy cursor-pointer motion-reduce:transition-none">ID</a>
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  // The header persists across ClientRouter navigations (transition:persist),
  // so listeners bind once; only route-dependent state refreshes on each
  // astro:page-load (fires on initial load + after each swap).
  const normalize = (path: string) => (path.length > 1 ? path.replace(/\/+$/, "") : path);

  let observer: IntersectionObserver | undefined;

  function syncActiveLinks(header: HTMLElement) {
    const current = normalize(window.location.pathname);
    header.querySelectorAll<HTMLAnchorElement>("nav a[href]").forEach((link) => {
      const href = link.getAttribute("href");
      if (href && normalize(href) === current) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    });
  }

  function bindHeader(header: HTMLElement) {
    const toggle = header.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const nav = header.querySelector<HTMLElement>("[data-mobile-nav]");
    if (!toggle || !nav) return;

    let hideTimer: number | undefined;

    const closeMenu = () => {
      nav.dataset.open = "false";
      toggle.setAttribute("aria-expanded", "false");
      // Timer rather than transitionend: several properties fire, and under
      // reduced motion the transform/clip-path ones never fire at all.
      window.clearTimeout(hideTimer);
      hideTimer = window.setTimeout(() => {
        if (nav.dataset.open === "false") nav.hidden = true;
      }, 300);
    };

    const openMenu = () => {
      window.clearTimeout(hideTimer);
      nav.hidden = false;
      // Force a style flush so the closed state is committed before the
      // open state lands; otherwise the enter transition can be skipped.
      void nav.offsetHeight;
      nav.dataset.open = "true";
      toggle.setAttribute("aria-expanded", "true");
      nav.querySelector<HTMLElement>("a")?.focus();
    };

    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      isOpen ? closeMenu() : openMenu();
    });

    nav.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeMenu();
        toggle.focus();
      }
    });

    nav.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));

    // Navigation completed: make sure the persisted menu is collapsed.
    document.addEventListener("astro:before-swap", () => {
      if (toggle.getAttribute("aria-expanded") === "true") closeMenu();
    });
  }

  function initHeader() {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    if (!header) return;

    if (header.dataset.bound !== "true") {
      header.dataset.bound = "true";
      bindHeader(header);
    }

    syncActiveLinks(header);

    // IntersectionObserver over a zero-height sentinel: no per-frame scroll work.
    // The sentinel lives in <body>, which is replaced on each swap, so the
    // observer is re-created against the fresh sentinel.
    observer?.disconnect();
    const sentinel = document.createElement("div");
    sentinel.setAttribute("aria-hidden", "true");
    sentinel.style.cssText = "position:absolute;top:0;left:0;height:4px;width:1px;pointer-events:none;";
    document.body.prepend(sentinel);

    observer = new IntersectionObserver(
      ([entry]) => {
        header.dataset.stuck = String(!entry.isIntersecting);
      },
      { threshold: 0 },
    );
    observer.observe(sentinel);
  }

  document.addEventListener("astro:page-load", initHeader);
</script>
