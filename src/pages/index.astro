---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import CapabilityCurve from "../components/CapabilityCurve.astro";
import { pad, shell } from "../lib/ui";

const problemCards = [
  { key: "problem1", title: "The disappearing agency", body: "Builds it, bills it, leaves." },
  {
    key: "problem2",
    title: "Short-term contractors",
    body: "Extra developers fill the gap for a while, but when the contract ends, the knowledge walks out with them.",
  },
  {
    key: "problem3",
    title: "Tech for the sake of it",
    body: "Trendy tools added before the basics are in place, so they cost more than they deliver.",
  },
  {
    key: "problem4",
    title: "Handover in name only",
    body: "The code is passed over, but nobody explains how it works or how to fix it.",
  },
];

const businessGets = [
  {
    key: "gets1",
    title: "We stay until it runs smoothly",
    body: "We don't leave at launch. We monitor the system, fix issues fast and keep improving it until it runs smoothly.",
    proof: "How we prove it: service recovery time, tracked from day one.",
  },
  {
    key: "gets2",
    title: "Knowledge that stays with the business",
    body: "Every system comes with clear documentation and guides, so the know-how belongs to the business, not to any one person.",
    proof: "How we prove it: documentation is reviewed and signed off at every stage.",
  },
  {
    key: "gets3",
    title: "The right tools, not the trendy ones",
    body: "We recommend what the business actually needs. Often the simplest option is the best value, and we'll say so. New technology comes in only when it clearly pays for itself.",
    proof: "How we prove it: every recommendation comes with its cost and expected return.",
  },
  {
    key: "gets4",
    title: "A transfer that actually works",
    body: "Before we sign off, whoever takes over, in-house staff or another provider, is walked through running, fixing and updating the system.",
    proof: "How we prove it: a transfer checklist, agreed in the contract.",
  },
];

const howWeWorkStages = [
  { label: "Discovery", newco: 90, client: 10, pager: 100, milestone: "Baseline Diagnostic", labelKey: "index.howwework.stage1.label", milestoneKey: "index.howwework.stage1.milestone" },
  { label: "Development", newco: 70, client: 35, pager: 75, milestone: "Joint Engineering", labelKey: "index.howwework.stage2.label", milestoneKey: "index.howwework.stage2.milestone" },
  { label: "Operations and Support", newco: 40, client: 65, pager: 40, milestone: "Shared Operations", labelKey: "index.howwework.stage3.label", milestoneKey: "index.howwework.stage3.milestone" },
  { label: "Ownership Transfer", newco: 10, client: 90, pager: 0, milestone: "Autonomous Ownership", labelKey: "index.howwework.stage4.label", milestoneKey: "index.howwework.stage4.milestone" },
];

const buildPrinciples = [
  { key: "principle1", title: "Keep it simple.", body: "No extra complexity until there's a real reason for it." },
  { key: "principle2", title: "Running it is part of the job.", body: "Monitoring, backups, cloud costs and recovery plans are included, not extras." },
  { key: "principle3", title: "Clear communication.", body: "Plain-language updates and no jargon, so decision-makers always know where things stand." },
  { key: "principle4", title: "Standard, proven technology.", body: "Widely used, well-supported tools, so any qualified engineer can pick the system up." },
  { key: "principle5", title: "Security from day one.", body: "Access controls, encryption and regular updates are built in, not added later." },
];
const adoptionSteps = [
  { key: "step1", label: "Get the data ready" },
  { key: "step2", label: "Start with one clear use case" },
  { key: "step3", label: "Expand carefully, with safeguards" },
];

const metrics = [
  { key: "metric1", metric: "Lead time", tells: "How long a change takes to go live" },
  { key: "metric2", metric: "Release frequency", tells: "How often updates go live" },
  { key: "metric3", metric: "Change failure rate", tells: "How often an update causes a problem" },
  { key: "metric4", metric: "Recovery time", tells: "How fast service is restored after an issue" },
  { key: "metric5", metric: "Rework rate", tells: "How much work has to be redone" },
  { key: "metric6", metric: "Uptime", tells: "How much of the time the system is available" },
  { key: "metric7", metric: "Response time", tells: "How quickly support requests are answered" },
  { key: "metric8", metric: "Transfer readiness", tells: "How complete the documentation and transfer checklist are" },
];

// Buttons hold one line on desktop; they may wrap only in narrow mobile columns.
const btn = "md:whitespace-nowrap";
---

<Layout titleKey="meta.index.title" descKey="meta.index.description" lcpImage="/images/intro-poster.webp">
  <!-- 1. Hero -->
  <section class="bg-white">
    <div class:list={[shell, "py-12 md:py-20"]}>
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-b border-line pb-4" data-hero-item>
        <span class="mono text-blue" data-i18n="index.hero.eyebrow">// INDEPENDENT SYSTEM ENGINEERING</span>
        <span class="text-sm font-semibold tracking-wide text-grey" data-i18n="index.hero.kicker">Engineering partner for growing businesses</span>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-12 md:mt-16 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-7">
          <h1 class="text-h1 uppercase text-navy text-balance tracking-tight lg:max-w-[16ch] lg:text-[clamp(3rem,4.6vw,4.5rem)]" data-i18n="index.hero.title">Technology built for independence.</h1>
          <p class="corners mono mt-10 inline-flex flex-wrap items-center gap-x-4 gap-y-1 border border-line bg-mist px-4 py-3 text-navy" data-hero-item>
            <span data-i18n="index.hero.tag1">We build</span><span aria-hidden="true" class="text-blue">·</span><span data-i18n="index.hero.tag2">We teach</span><span aria-hidden="true" class="text-blue">·</span><span data-i18n="index.hero.tag3">You own.</span>
          </p>
        </div>

        <div class="flex flex-col lg:col-span-5 lg:border-l lg:border-line lg:pl-8">
          <p class="text-[18px] leading-[1.6] text-slate text-pretty" data-hero-item data-i18n="index.hero.lede">
            We engineer systems to a high standard, then transfer full ownership to the business: the code,
            the documentation and the know-how. No vendor lock-in. No hidden dependencies.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4" data-hero-item>
            <Button href="/contact" variant="primary" class={btn}><span data-i18n="index.hero.cta">Talk to us</span></Button>
            <button type="button" class="open-video-trigger inline-flex items-center gap-2 text-body font-semibold text-blue underline decoration-blue underline-offset-4 hover:text-blue-dark" aria-haspopup="dialog" data-i18n="index.hero.video">Watch the 1 minute intro</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. The problem -->
  <section class="border-t border-line bg-mist" aria-labelledby="problem-title">
    <div class:list={[shell, "py-16 md:py-24"]}>
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:gap-8">
        <h2 id="problem-title" class="max-w-[24ch] text-h2 text-navy text-balance lg:col-span-7" data-i18n="index.problem.title">
          Getting software built is easy. Keeping it running is the hard part.
        </h2>
        <p class="max-w-[68ch] text-body-lg text-slate lg:col-span-5 lg:pt-1" data-i18n="index.problem.lede">
          Many agencies deliver a system and leave. The business is left with code nobody in-house can fix when something breaks.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 overflow-hidden rounded-xl border border-line bg-white md:grid-cols-2">
        {
          problemCards.map((card, i) => (
            <div class="border-t border-line p-6 first:border-t-0 md:p-8 md:nth-2:border-t-0 md:odd:border-r">
              <span class="mono text-blue">{pad(i)}</span>
              <h3 class="mt-6 text-h3 text-navy" data-i18n={`index.problem.${card.key}.title`}>{card.title}</h3>
              <p class="mt-3 text-body text-slate" data-i18n={`index.problem.${card.key}.body`}>{card.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3.3 What the business gets -->
  <section class="bg-white" aria-labelledby="business-gets-title">
    <div class:list={[shell, "py-16 md:py-24"]}>
      <h2 id="business-gets-title" class="text-h2 text-navy text-balance" data-i18n="index.gets.title">What the business gets instead.</h2>

      <div class="mt-12 grid grid-cols-1 gap-x-12 gap-y-12 md:grid-cols-2">
        {
          businessGets.map((card, i) => (
            <div class="flex flex-col justify-between border-t border-navy pt-6">
              <div>
                <span class="mono text-grey">{`// ${pad(i)}`}</span>
                <h3 class="mt-4 text-h3 text-navy" data-i18n={`index.gets.${card.key}.title`}>{card.title}</h3>
                <p class="mt-3 text-body text-slate" data-i18n={`index.gets.${card.key}.body`}>{card.body}</p>
              </div>
              <p class="mt-6 w-fit border border-line bg-mist px-3 py-2 text-sm text-navy" data-i18n={`index.gets.${card.key}.proof`}>{card.proof}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3.4 How we work -->
  <section id="how-we-work" class="scroll-mt-24 border-t border-line bg-white">
    <div class:list={[shell, "py-16 md:py-24"]}>
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-4">
          <span class="mono text-grey" data-i18n="index.howwework.eyebrow">// PROCESS</span>
          <h2 class="mt-4 text-h2 text-navy text-balance" data-i18n="index.howwework.title">How a project comes together.</h2>
          <p class="mt-4 text-body-lg text-slate" data-i18n="index.howwework.lede">
            Four clear stages take each project from the first conversation to a system the business fully owns.
          </p>
          <p class="mt-6 text-sm text-grey" data-i18n="index.howwework.note">
            Day-to-day control shifts to the business, stage by stage. Ongoing support is a choice, never a requirement.
          </p>
          <a href="/how-we-work" class="mt-8 inline-block font-semibold text-blue underline underline-offset-4 hover:text-blue-dark" data-i18n="index.howwework.link">See how it works →</a>
        </div>

        <div class="lg:col-span-8">
          <div class="corners rounded-xl border border-line bg-mist p-3 md:p-6">
            <div class="mb-4 flex items-center justify-between border-b border-line pb-3">
              <span class="mono text-grey" data-i18n="index.howwework.fig">// FIG. 01</span>
              <span class="mono text-grey" data-i18n="index.howwework.figtitle">OWNERSHIP CURVE</span>
            </div>
            <CapabilityCurve phases={howWeWorkStages} caption="" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3.5 Discovery (the only dark section) -->
  <section id="discovery" class="scroll-mt-24 bg-navy text-white" aria-labelledby="discovery-title">
    <div class:list={[shell, "py-16 md:py-24"]}>
      <div class="corners corners-light rounded-xl border border-white/15 p-8 md:p-12">
        <span class="mono text-white/60" data-i18n="index.discovery.eyebrow">// DISCOVERY</span>
        <h2 id="discovery-title" class="mt-4 text-h2 text-white text-balance" data-i18n="index.discovery.title">Every project starts with a clear picture.</h2>
        <p class="text-body-lg text-white/80 max-w-[68ch] mt-4" data-i18n="index.discovery.lede">
          Before anything is built, we take a close look at how the business runs today. In three steps, that becomes a plan the business keeps, whether it continues with us or not.
        </p>

        <div class="mt-12 grid grid-cols-1 divide-y divide-white/15 border-y border-white/15 md:grid-cols-3 md:divide-x md:divide-y-0">
          <div class="py-8 md:px-8 md:py-10 md:first:pl-0">
            <span class="mono text-white/60" data-i18n="index.discovery.step1.num">STEP // 01</span>
            <svg class="mt-6 h-8 w-8 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="6.5" />
              <path d="m16 16 4.5 4.5" />
              <path d="M8.5 11h5M11 8.5v5" />
            </svg>
            <h3 class="text-h3 font-semibold text-white mt-4" data-i18n="index.discovery.step1.title">Understand</h3>
            <p class="text-body text-white/70 mt-2" data-i18n="index.discovery.step1.body">We map current systems, data flows and integrations, and pinpoint the bottlenecks.</p>
          </div>
          <div class="py-8 md:px-8 md:py-10">
            <span class="mono text-white/60" data-i18n="index.discovery.step2.num">STEP // 02</span>
            <svg class="mt-6 h-8 w-8 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 6h16M4 12h11M4 18h6" />
              <path d="m18 15 2 2 3-4" />
            </svg>
            <h3 class="text-h3 font-semibold text-white mt-4" data-i18n="index.discovery.step2.title">Prioritise</h3>
            <p class="text-body text-white/70 mt-2" data-i18n="index.discovery.step2.body">We rank the risks, such as security gaps and single points of failure, and decide what to build, upgrade or leave as is.</p>
          </div>
          <div class="py-8 md:px-8 md:py-10 md:last:pr-0">
            <span class="mono text-white/60" data-i18n="index.discovery.step3.num">STEP // 03</span>
            <svg class="mt-6 h-8 w-8 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="5" cy="18" r="2" />
              <circle cx="12" cy="8" r="2" />
              <circle cx="19" cy="5" r="2" />
              <path d="M6.5 16.5 10.5 9.6M13.8 7.2l3.4-1.4" />
            </svg>
            <h3 class="text-h3 font-semibold text-white mt-4" data-i18n="index.discovery.step3.title">Delivery plan</h3>
            <p class="text-body text-white/70 mt-2" data-i18n="index.discovery.step3.body">We deliver a technical roadmap with the proposed architecture, milestones and estimated costs, so every decision is based on facts.</p>
          </div>
        </div>

        <div class="mt-10 flex justify-start md:justify-end">
          <Button href="/contact" variant="inverse"><span data-i18n="index.discovery.cta">Talk to us</span></Button>
        </div>
      </div>
    </div>
  </section>

  <!-- 3.6 How we build -->
  <section id="how-we-build" class="scroll-mt-24 bg-white">
    <div class:list={[shell, "py-16 md:py-24"]}>
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:sticky lg:top-28 lg:col-span-4 lg:self-start">
          <span class="mono text-grey" data-i18n="index.build.eyebrow">// PRINCIPLES</span>
          <h2 class="mt-4 text-h2 text-navy text-balance" data-i18n="index.build.title">Simple, honest engineering.</h2>
        </div>

        <ol class="border-t border-navy lg:col-span-8">
          {
            buildPrinciples.map((item, i) => (
              <li class="grid grid-cols-[3.5rem_1fr] gap-4 border-b border-line py-6 md:grid-cols-[5rem_1fr]">
                <span class="mono text-blue md:text-base">{pad(i)}</span>
                <p class="text-body text-slate">
                  <strong class="font-semibold text-navy" data-i18n={`index.build.${item.key}.title`}>{item.title}</strong> <span data-i18n={`index.build.${item.key}.body`}>{item.body}</span>
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- 3.7 AI adoption, an optional service (mist). The only home page section that talks about AI. -->
  <section id="ai-adoption" class="scroll-mt-24 bg-white" aria-labelledby="ai-adoption-title">
    <div class:list={[shell, "pb-16 md:pb-24"]}>
      <div class="rounded-xl border border-line bg-mist p-6 md:p-12">
        <p class="mono text-grey" data-i18n="index.ai.eyebrow">// Optional service</p>
        <h2 id="ai-adoption-title" class="mt-3 text-h2 text-navy text-balance" data-i18n="index.ai.title">Want to bring AI into the business? We can help.</h2>
        <p class="text-body-lg text-slate max-w-[68ch] mt-4" data-i18n="index.ai.lede">
          Our systems are engineered by people, not generated by AI. When a business wants to use AI, we help it adopt it properly: reliable data first, then AI only where it clearly pays off.
        </p>

        <ol class="mt-12 grid grid-cols-1 overflow-hidden rounded-lg border border-line bg-white md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-line">
          {
            adoptionSteps.map((step, i) => (
              <li class="relative p-6">
                <span class="mono text-blue">{pad(i)}</span>
                <p class="mt-6 text-body-lg font-semibold text-navy" data-i18n={`index.ai.${step.key}`}>{step.label}</p>
                {i < adoptionSteps.length - 1 && (
                  <span aria-hidden="true" class="mono absolute right-4 top-6 hidden text-grey md:block">→</span>
                )}
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- 3.8 The numbers we track -->
  <section id="numbers" class="scroll-mt-24 border-t border-line bg-white" aria-labelledby="numbers-title">
    <div class:list={[shell, "py-16 md:py-24"]}>
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:sticky lg:top-28 lg:col-span-5 lg:self-start">
          <span class="mono text-grey" data-i18n="index.numbers.eyebrow">// METRICS</span>
          <h2 id="numbers-title" class="mt-4 text-h2 text-navy text-balance" data-i18n="index.numbers.title">Eight numbers that prove progress.</h2>
          <p class="text-body-lg text-slate max-w-[68ch] mt-4" data-i18n="index.numbers.lede">
            No vague status reports. We measure these on every project and report them in plain language. The first four are the industry-standard DORA metrics used by top engineering teams.
          </p>
        </div>

        <div class="corners overflow-hidden rounded-xl border border-line bg-white lg:col-span-7">
          <table class="w-full text-left border-collapse">
            <caption class="sr-only">Eight numbers that prove progress.</caption>
            <thead>
              <tr class="border-b border-line bg-mist">
                <th scope="col" class="mono w-2/5 px-4 py-4 text-navy md:w-1/3 md:px-6" data-i18n="index.numbers.col-metric">Metric</th>
                <th scope="col" class="mono px-4 py-4 text-navy md:px-6" data-i18n="index.numbers.col-tells">What it tells you</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              {
                metrics.map((row, i) => (
                  <tr>
                    <th scope="row" class="px-4 py-4 align-top text-left font-bold text-navy md:px-6">
                      <span class="mono mr-2 text-blue">{pad(i)}</span><span data-i18n={`index.numbers.${row.key}.metric`}>{row.metric}</span>
                    </th>
                    <td class="px-4 py-4 text-slate md:px-6" data-i18n={`index.numbers.${row.key}.tells`}>{row.tells}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- 3.9 Final CTA -->
  <section class="bg-mist">
    <div class:list={[shell, "py-16 md:py-24"]}>
      <div class="corners rounded-xl border border-line bg-white p-8 md:p-16">
        <div class="grid grid-cols-1 items-end gap-8 lg:grid-cols-12 lg:gap-12">
          <div class="lg:col-span-7">
            <h2 class="max-w-[24ch] text-h2 text-navy text-balance" data-i18n="index.cta.title">Own the technology your business runs on.</h2>
            <p class="mt-4 max-w-[68ch] text-body-lg text-slate text-pretty" data-i18n="index.cta.body">Whether it's a brand-new system or improving one already in place, tell us what's slowing the business down and we'll suggest the best place to start.</p>
          </div>
          <div class="flex flex-col items-start gap-3 lg:col-span-5 lg:items-end lg:justify-self-end">
            <Button href="/contact" variant="primary" class={btn}><span data-i18n="index.cta.button">Talk to us</span></Button>
            <p class="text-sm text-slate text-start lg:text-end sm:whitespace-nowrap">
              <span data-i18n="index.cta.overview">Prefer to review first?</span>{' '}
              <a
                href="/downloads/kyron-engineering-company-overview-en.pdf"
                data-i18n-attr="href:overview.href"
                target="_blank"
                rel="noopener"
                class="underline underline-offset-4 hover:text-navy"
              >
                <span data-i18n="overview.link">View company overview (PDF)</span>
              </a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <dialog id="video-dialog" data-lenis-prevent class="fixed inset-0 m-auto w-[min(92vw,960px)] max-h-[92vh] overflow-hidden rounded-[12px] border border-line bg-mist p-0 shadow-2xl backdrop:bg-navy/75 backdrop:backdrop-blur-sm open:flex open:flex-col" aria-labelledby="video-dialog-title">
    <div class="flex items-center justify-between border-b border-line px-4 py-3 md:px-6">
      <h2 id="video-dialog-title" class="text-sm font-semibold tracking-wide text-navy" data-i18n="index.video.title">Intro Brief · 1 minute</h2>
      <button type="button" class="close-video-trigger -my-2 -mr-2 min-h-[44px] px-2 text-sm font-semibold text-grey hover:text-navy" data-i18n-attr="aria-label:index.video.close-aria" aria-label="ESC / Close video dialog"><span data-i18n="index.video.close">ESC / Close</span></button>
    </div>
    <video id="intro-video" controls playsinline preload="none" poster="/images/intro-poster.webp" class="h-full w-full object-contain">
      <source src="/videos/intro.mp4" type="video/mp4" />
      <track kind="captions" src="/videos/intro.vtt" srclang="en" label="English" />
      <span data-i18n="index.video.fallback">Your browser does not support the video tag.</span>
    </video>
  </dialog>

  <script>
    function initVideoDialog() {
      const dialog = document.getElementById("video-dialog") as HTMLDialogElement | null;
      const video = document.getElementById("intro-video") as HTMLVideoElement | null;
      if (dialog && video) {
        document.querySelectorAll(".open-video-trigger").forEach((el) =>
          el.addEventListener("click", () => {
            const lang = document.documentElement.lang === "id" ? "id" : "en";
            if (video.dataset.lang !== lang) {
              const sfx = lang === "id" ? "-id" : "";
              video.dataset.lang = lang;
              video.poster = lang === "id" ? "/images/intro-poster-id.webp" : "/images/intro-poster.webp";
              video.querySelector("source")?.setAttribute("src", `/videos/intro${sfx}.mp4`);
              video.querySelector("track")?.setAttribute("src", `/videos/intro${sfx}.vtt`);
              video.querySelector("track")?.setAttribute("srclang", lang);
              video.load();
            }
            dialog.showModal();
          }),
        );
        dialog.querySelector(".close-video-trigger")?.addEventListener("click", () => dialog.close());
        dialog.addEventListener("close", () => video.pause());
        dialog.addEventListener("click", (e) => {
          if (e.target === dialog) dialog.close();
        });
      }
    }
    document.addEventListener("astro:page-load", initVideoDialog);
  </script>
</Layout>
