---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import SplitHeading from "../components/SplitHeading.astro";
import CapabilityCurve from "../components/CapabilityCurve.astro";
import { Icon } from "astro-icon/components";

const heroProof = [
  "Build with your team",
  "Operate the system together",
  "Measure the path to independence",
];

const dependencyCosts = [
  {
    default: "Build, invoice, disappear",
    remains: "A system nobody internally can operate",
  },
  {
    default: "Add people by the day",
    remains: "Temporary capacity without retained capability",
  },
  {
    default: "Add AI to weak foundations",
    remains: "A demo without trustworthy data or evaluation",
  },
  {
    default: "Handover as a final ZIP file",
    remains: "Vendor dependency disguised as delivery",
  },
];

const outcomes = [
  {
    name: "Capacity",
    body: "Your team can ship and operate more of the roadmap without waiting on us.",
    evidence: "Seen in faster onboarding, safer releases, and measurable reuse.",
  },
  {
    name: "Longevity",
    body: "The system stays understandable and operable as people, priorities, and vendors change.",
    evidence: "Evidenced by ADRs, runbooks, recovery practice, and clear ownership.",
  },
  {
    name: "Leverage",
    body: "Your team can make better decisions because the data, delivery path, and operating model are sound.",
    evidence: "Tracked through lead time, deployment frequency, and rework.",
  },
];

const diagnosticOutputs = [
  "Current-state architecture and dependency map",
  "Data-flow and data-readiness assessment",
  "Security and operational risk register",
  "Delivery and capability baseline",
  "AI-readiness scorecard",
  "Prioritised 90-day backlog",
  "Twelve-month investment roadmap",
  "Target operating model and estimated run cost",
  "Build-versus-buy recommendations",
  "Capability-transfer plan",
];

const principles = [
  {
    title: "Diagnose before we build",
    body: "We baseline the system and the operating model before committing to a roadmap.",
  },
  {
    title: "Build with your team, not around it",
    body: "Your engineers are in the room and in the codebase from day one.",
  },
  {
    title: "Decisions are recorded, not tribal",
    body: "Architecture decisions and deviations are written down as we make them.",
  },
  {
    title: "Handover is planned, not improvised",
    body: "The transfer plan exists before the first line of code is written.",
  },
  {
    title: "We measure toward our own exit",
    body: "Progress is judged by how little you need us, not how much.",
  },
];

const maturityLadder = [
  "Data foundation",
  "Decision support",
  "Assistive AI",
  "Embedded intelligence",
  "Controlled automation",
];

const evidenceCategories = [
  "Lead time",
  "Deployment frequency",
  "Change-failure rate",
  "Recovery time",
  "Rework",
  "Onboarding-to-first-PR",
  "Platform reuse",
  "Capability scorecard progress",
];

const goodFit = [
  "You run a complex, multi-location operation and need technology you can own.",
  "You can name a person to work alongside our engineers and make decisions.",
  "You want evidence before committing to a major build, migration, or AI initiative.",
];

const notFit = [
  "You want a one-off build with no shared operating responsibility.",
  "You are comparing day rates before deciding what the system needs.",
  "You want AI shipped before addressing the data, ownership, or safeguards it depends on.",
];

const shell = "mx-auto max-w-content px-[clamp(20px,5vw,80px)]";
---

<Layout
  title="Build the technology your business can own"
  description="NewCo is an embedded engineering capability partner. We build with your team, operate the system with you, and measure progress toward your independence."
>
  <!-- 7.1 Hero — the owned outcome -->
  <section class:list={[shell, "pt-16 pb-24 md:pt-12 md:pb-12"]}>
    <div class="grid gap-12 md:grid-cols-12 md:gap-x-6">
      <div class="md:col-span-7" data-hero-intro>
        <p data-hero-item class="label text-signal">Embedded engineering capability partner</p>
        <SplitHeading as="h1" class="mt-6 text-h1 leading-[1.05] font-semibold text-ink text-balance">
          Build the technology your business can own.
        </SplitHeading>
        <p data-hero-item class="mt-8 measure text-body-lg text-graphite">
          NewCo helps operationally complex businesses turn fragile systems and scattered technical
          ownership into technology their teams can run, improve, and eventually own.
        </p>
        <div data-hero-item class="mt-10 flex flex-wrap gap-4">
          <Button href="/contact" variant="primary">Discuss your situation</Button>
          <Button href="#capability-curve" variant="secondary">
            See how the capability transfer works
          </Button>
        </div>
        <ul data-hero-item class="mt-12 flex flex-col gap-2 border-t border-line pt-6 sm:flex-row sm:gap-8">
          {heroProof.map((proof) => <li class="label text-graphite">{proof}</li>)}
        </ul>
      </div>

      <!--
        The hero diagram is authored, complete without JavaScript, and sized for
        a five-column measure: bars, not the wide phase curve.
      -->
      <div class="md:col-span-5 md:col-start-8 md:pt-2">
        <CapabilityCurve compact />
      </div>
    </div>
  </section>

  <!-- 7.2 Problem — dependency has a cost -->
  <section class="border-t border-line bg-surface">
    <div class:list={[shell, "py-16 md:py-24"]}>
      <div class="grid gap-8 md:grid-cols-12 md:gap-x-6">
        <p class="label text-graphite md:col-span-3">01 — The problem</p>
        <div class="md:col-span-9">
          <SplitHeading as="h2" class="text-h2 font-semibold text-ink text-balance">
            Most technology problems are operating-model problems.
          </SplitHeading>
          <p class="mt-6 measure text-body-lg text-graphite">
            A release is not the same as capability. You can hold working software and still have no
            one who can defend its architecture, run its recovery, or extend it without the vendor
            who wrote it.
          </p>
        </div>
      </div>

      <div class="mt-16 hidden gap-x-6 border-b border-line pb-4 md:grid md:grid-cols-12">
        <p class="label text-graphite md:col-span-5 md:col-start-4">Common default</p>
        <p class="label text-signal md:col-span-4">What remains afterward</p>
      </div>

      <dl class="flex flex-col divide-y divide-line border-y border-line md:mt-0 md:border-t-0 max-md:mt-16">
        {
          dependencyCosts.map((row, i) => (
            <div data-reveal class="grid gap-x-6 gap-y-2 py-6 md:grid-cols-12">
              <span class="label text-graphite/70 md:col-span-3">{String(i + 1).padStart(2, "0")}</span>
              <dt class="text-h3 text-ink md:col-span-5">{row.default}</dt>
              <dd class="text-body text-graphite md:col-span-4 md:text-body-lg">{row.remains}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- 7.3 Outcomes — capacity, longevity, leverage -->
  <section class:list={[shell, "py-24 md:py-32"]}>
    <div class="grid gap-8 md:grid-cols-12 md:gap-x-6">
      <p class="label text-graphite md:col-span-3">02 — Outcomes</p>
      <SplitHeading as="h2" class="text-h2 font-semibold text-ink text-balance md:col-span-9">
        The deliverable is more than software.
      </SplitHeading>
    </div>

    <div class="mt-16 grid gap-12 md:grid-cols-3 md:gap-8">
      {
        outcomes.map((outcome) => (
          <div data-reveal class="border-t-2 border-ink pt-6">
            <p class="text-h3 font-semibold text-ink">{outcome.name}</p>
            <p class="mt-3 text-body-lg text-graphite">{outcome.body}</p>
            <p class="mt-6 text-body text-signal">{outcome.evidence}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 7.4 Capability curve -->
  <section id="capability-curve" class="scroll-mt-24 border-t border-line bg-surface">
    <div class:list={[shell, "py-24 md:py-32"]}>
      <div class="grid gap-8 md:grid-cols-12 md:gap-x-6">
        <p class="label text-graphite md:col-span-3">03 — Engagement model</p>
        <div class="md:col-span-9">
          <SplitHeading as="h2" class="text-h2 font-semibold text-ink text-balance">
            A route from external support to internal ownership.
          </SplitHeading>
          <p class="mt-6 measure text-body-lg text-graphite">
            Five phases on one connected path. Our day-to-day ownership falls as yours rises, and
            advisory support remains available after the transfer is complete.
          </p>
        </div>
      </div>

      <div class="mt-16">
        <CapabilityCurve />
      </div>
    </div>
  </section>

  <!-- 7.5 Technical Diagnostic -->
  <section class:list={[shell, "py-24 md:py-32"]}>
    <div class="rounded-sm bg-ink px-6 py-12 text-canvas md:px-12 md:py-16">
      <div class="grid gap-8 md:grid-cols-12 md:gap-x-6">
        <p class="label text-canvas/60 md:col-span-3">04 — First step</p>
        <div class="md:col-span-9">
          <SplitHeading as="h2" class="text-h2 font-semibold text-canvas text-balance">
            Start with evidence, not a speculative estimate.
          </SplitHeading>
          <p class="mt-6 measure text-body-lg text-canvas/80">
            In 15 business days we map the systems, data, risks, delivery capability, and investment
            choices that matter. It is a fixed-fee, standalone product.
            <strong class="font-semibold text-canvas"> You own the output</strong> and can take it to
            any vendor.
          </p>
        </div>
      </div>

      <ol class="mt-12 grid gap-x-8 border-t border-canvas/20 sm:grid-cols-2 lg:grid-cols-3">
        {
          diagnosticOutputs.map((output, i) => (
            <li class="flex gap-4 border-b border-canvas/15 py-4">
              <span class="label shrink-0 text-canvas/50 tabular-nums">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="text-body text-canvas/90">{output}</span>
            </li>
          ))
        }
      </ol>

      <div class="mt-12">
        <Button href="/diagnostic" variant="primary" class="w-fit">
          Explore the Technical Diagnostic
        </Button>
      </div>
    </div>
  </section>

  <!-- 7.6 Principles -->
  <section class="border-t border-line bg-surface">
    <div class:list={[shell, "py-24 md:py-32"]}>
      <div class="grid gap-8 md:grid-cols-12 md:gap-x-6">
        <p class="label text-graphite md:col-span-3">05 — Principles</p>
        <SplitHeading as="h2" class="text-h2 font-semibold text-ink text-balance md:col-span-9">
          Opinionated about ownership. Pragmatic about technology.
        </SplitHeading>
      </div>

      <div class="mt-16 flex flex-col divide-y divide-line border-t border-line">
        {
          principles.map((principle, i) => (
            <div data-reveal class="grid gap-x-6 gap-y-2 py-8 md:grid-cols-12">
              <span class="label text-signal md:col-span-3">{String(i + 1).padStart(2, "0")}</span>
              <p class="text-h3 font-semibold text-ink md:col-span-5">{principle.title}</p>
              <p class="text-body text-graphite md:col-span-4">{principle.body}</p>
            </div>
          ))
        }
      </div>

      <a
        href="/approach"
        class="mt-10 inline-flex items-center gap-2 text-body font-medium text-signal hover:text-signal-dark"
      >
        See the full approach
        <Icon name="solar:arrow-right-linear" class="h-4 w-4" aria-hidden="true" />
      </a>
    </div>
  </section>

  <!-- 7.7 AI — disciplined, not performative -->
  <section class:list={[shell, "py-24 md:py-32"]}>
    <div class="grid gap-8 md:grid-cols-12 md:gap-x-6">
      <p class="label text-graphite md:col-span-3">06 — AI</p>
      <div class="md:col-span-9">
        <SplitHeading as="h2" class="text-h2 font-semibold text-ink text-balance">
          AI is a delivery advantage and a product option, not a strategy by itself.
        </SplitHeading>
        <p class="mt-6 measure text-body-lg text-graphite">
          Not every engagement needs AI. Where it earns its place, we require data, a decision it
          improves, an evaluation method, a named owner, a cost model, a failure-handling plan, and a
          safe disable path.
        </p>
      </div>
    </div>

    <ol class="mt-16 grid gap-x-6 gap-y-8 sm:grid-cols-2 md:grid-cols-5">
      {
        maturityLadder.map((stage, i) => (
          <li data-reveal class="flex flex-col gap-4">
            <span
              class="block h-[3px] bg-signal"
              style={`opacity:${0.35 + i * 0.1625}`}
              aria-hidden="true"
            />
            <p class="text-body font-medium text-ink">{stage}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-8 measure text-body text-graphite">
      Each rung depends on the one below it. We do not skip rungs to reach a demo faster.
    </p>
  </section>

  <!-- 7.8 Qualification -->
  <section class="border-t border-line bg-surface">
    <div class:list={[shell, "py-24 md:py-32"]}>
      <div class="grid gap-8 md:grid-cols-12 md:gap-x-6">
        <p class="label text-graphite md:col-span-3">07 — Fit</p>
        <SplitHeading as="h2" class="text-h2 font-semibold text-ink text-balance md:col-span-9">
          NewCo works best when ownership is part of the brief.
        </SplitHeading>
      </div>

      <div class="mt-16 grid gap-12 md:grid-cols-2 md:gap-8">
        <div data-reveal>
          <p class="label border-b border-line pb-4 text-success">Good fit</p>
          <ul class="mt-6 flex flex-col gap-4">
            {
              goodFit.map((item) => (
                <li class="flex items-start gap-3 text-body-lg text-ink">
                  <Icon
                    name="solar:check-circle-linear"
                    class="mt-1 h-5 w-5 shrink-0 text-success"
                    aria-hidden="true"
                  />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
        <div data-reveal>
          <p class="label border-b border-line pb-4 text-graphite">Probably not a fit</p>
          <ul class="mt-6 flex flex-col gap-4">
            {
              notFit.map((item) => (
                <li class="flex items-start gap-3 text-body-lg text-graphite">
                  <Icon
                    name="solar:close-circle-linear"
                    class="mt-1 h-5 w-5 shrink-0 text-graphite"
                    aria-hidden="true"
                  />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 7.9 Evidence framework -->
  <section class:list={[shell, "py-24 md:py-32"]}>
    <div class="grid gap-8 md:grid-cols-12 md:gap-x-6">
      <p class="label text-graphite md:col-span-3">08 — Evidence</p>
      <div class="md:col-span-9">
        <SplitHeading as="h2" class="text-h2 font-semibold text-ink text-balance">
          Evidence will replace promises.
        </SplitHeading>
        <p class="mt-6 measure text-body-lg text-graphite">
          We have no client case studies to publish yet. These are the measures we baseline at the
          start of an engagement and report against as the work runs.
        </p>
      </div>
    </div>

    <ul class="mt-16 flex flex-wrap gap-3">
      {
        evidenceCategories.map((category) => (
          <li class="label rounded-full border border-line bg-surface px-4 py-2 text-graphite">
            {category}
          </li>
        ))
      }
    </ul>

    <p class="mt-10 measure text-body-lg font-medium text-ink">
      We publish measured outcomes when the work gives us evidence to publish.
    </p>
  </section>

  <!-- 7.10 Final CTA -->
  <section class="border-t border-line bg-ink">
    <div class:list={[shell, "py-24 text-center md:py-32"]}>
      <SplitHeading as="h2" class="mx-auto max-w-[18ch] text-h1 font-semibold text-canvas text-balance">
        Own the next stage of your technology.
      </SplitHeading>
      <p class="mx-auto mt-8 max-w-[52ch] text-body-lg text-canvas/80">
        Tell us where your systems, data, delivery process, or internal capability are constraining
        the business. We will determine whether a Technical Diagnostic is the right next step.
      </p>
      <div class="mt-10 flex justify-center">
        <Button href="/contact" variant="primary">Start a conversation</Button>
      </div>
      <p class="mt-8 label text-canvas/60">
        No speculative estimate. No obligation to continue after the diagnostic.
      </p>
    </div>
  </section>
</Layout>
