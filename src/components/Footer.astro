---
const links = [
  { href: "/", label: "Home", key: "nav.home" },
  { href: "/how-we-work", label: "How we work", key: "nav.how-we-work" },
  { href: "/about", label: "About", key: "nav.about" },
  { href: "/contact", label: "Contact", key: "nav.contact" },
];
---

<footer class="border-t border-white/10 bg-navy text-white">
  <div class="mx-auto max-w-[1200px] px-4 md:px-6 pt-16 pb-8">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
      <div class="max-w-measure">
        <p class="text-h3 font-semibold text-white">Kyron Engineering</p>
        <p class="mt-4 text-body text-white/70" data-i18n="footer.tagline">
          Systems built properly, documented fully, and owned by the business.
        </p>
        <a
          href="/contact"
          class="mt-8 inline-block rounded-md bg-white px-5 py-3 font-semibold text-navy hover:bg-mist"
          data-i18n="footer.cta"
        >
          Start a conversation
        </a>
      </div>

      <nav aria-label="Footer">
        <p class="text-sm font-semibold uppercase tracking-wider text-white/50" data-i18n="footer.company">Company</p>
        <ul class="mt-4 flex flex-col gap-3">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class="text-body text-white/80 hover:text-white" data-i18n={link.key}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-white/50" data-i18n="footer.connect">Connect</p>
        <ul class="mt-4 flex flex-col gap-3">
          <li>
            <span class="text-body text-white/80">GitHub</span>
          </li>
          <li>
            <span class="text-body text-white/80">LinkedIn</span>
          </li>
          <li>
            <span class="text-body text-white/80">X (Twitter)</span>
          </li>
        </ul>
      </div>

      <address class="not-italic">
        <p class="text-sm font-semibold uppercase tracking-wider text-white/50" data-i18n="footer.office-label">Registered office</p>
        <p class="mt-4 text-sm text-white/70">Jakarta, Indonesia</p>
        <div class="mt-6 flex flex-col gap-2 share-buttons" aria-label="Share">
          <p class="text-xs uppercase tracking-wider text-white/50">Share</p>
          <div class="flex items-center gap-3">
            <a href="https://twitter.com/intent/tweet?text=Kyron%20Engineering%20-%20Engineering%20Partnership&url=https://projectx-gold.vercel.app/" target="_blank" rel="noopener noreferrer" class="text-xs text-white/70 hover:text-white" aria-label="Share on X">X</a>
            <span class="text-white/20">&bull;</span>
            <a href="https://www.linkedin.com/shareArticle?mini=true&url=https://projectx-gold.vercel.app/" target="_blank" rel="noopener noreferrer" class="text-xs text-white/70 hover:text-white" aria-label="Share on LinkedIn">LinkedIn</a>
            <span class="text-white/20">&bull;</span>
            <a href="https://www.facebook.com/sharer/sharer.php?u=https://projectx-gold.vercel.app/" target="_blank" rel="noopener noreferrer" class="text-xs text-white/70 hover:text-white" aria-label="Share on Facebook">Facebook</a>
          </div>
        </div>
      </address>
    </div>
    <div class="mt-16 flex flex-col gap-2 border-t border-white/10 pt-6 text-sm text-white/60 sm:flex-row sm:justify-between">
      <p>&copy; {new Date().getFullYear()} Kyron Engineering. <span data-i18n="footer.rights">All rights reserved.</span></p>
      <a href="/privacy" class="hover:text-white" data-i18n="footer.privacy">Privacy</a>
    </div>
  </div>
</footer>
