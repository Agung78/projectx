---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Analytics from "@vercel/analytics/astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  titleKey?: string;
  descKey?: string;
  lcpImage?: string;
}

const { titleKey, descKey, lcpImage } = Astro.props;
const isId = /^\/id(\/|$)/.test(Astro.url.pathname);
const lang = isId ? "id" : "en";
let { title = "", description = "" } = Astro.props;
if (titleKey || descKey) {
  const { STRINGS } = await import("../i18n/dictionary");
  if (titleKey && STRINGS[titleKey]) title = STRINGS[titleKey][lang];
  if (descKey && STRINGS[descKey]) description = STRINGS[descKey][lang];
}

const pageTitle = title.includes("Kyron Engineering") ? title : `${title} | Kyron Engineering`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/og-image.png", Astro.site);
const enPath = Astro.url.pathname.replace(/^\/id(?=\/|$)/, "") || "/";
const idPath = `/id${enPath === "/" ? "/" : enPath}`;
const alternates = [["en", enPath], ["id", idPath], ["x-default", enPath]];
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": new URL("/#organization", Astro.site).href,
      name: "Kyron Engineering",
      url: new URL("/", Astro.site).href,
      logo: new URL("/favicon.svg", Astro.site).href,
      description:
        "Kyron Engineering builds with your team, operates systems together, and measures progress toward your engineering independence.",
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "customer support",
        url: new URL("/contact/", Astro.site).href,
      },
      address: {
        "@type": "PostalAddress",
        addressCountry: "ID",
      },
    },
    {
      "@type": "WebSite",
      "@id": new URL("/#website", Astro.site).href,
      url: new URL("/", Astro.site).href,
      name: "Kyron Engineering",
      publisher: { "@id": new URL("/#organization", Astro.site).href },
    },
    ...(isHome
      ? []
      : [
          {
            "@type": "BreadcrumbList",
            itemListElement: [
              {
                "@type": "ListItem",
                position: 1,
                name: "Home",
                item: new URL("/", Astro.site).href,
              },
              {
                "@type": "ListItem",
                position: 2,
                name: pageTitle,
                item: canonicalURL.href,
              },
            ],
          },
        ]),
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/jakarta-latin.woff2" crossorigin />
    {lcpImage && <link rel="preload" as="image" href={lcpImage} fetchpriority="high" />}
    <link rel="canonical" href={canonicalURL} />
    {alternates.map(([hreflang, path]) => <link rel="alternate" hreflang={hreflang} href={new URL(path, Astro.site)} />)}
    <link rel="llms" href="/llms.txt" />
    <title data-title-key={titleKey}>{pageTitle}</title>
    <meta name="description" content={description} data-desc-key={descKey} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={isId ? "id_ID" : "en_US"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <script>
      import "../scripts/motion.ts";
    </script>
    <script>
      import "../i18n/apply.ts";
    </script>
    <ClientRouter />
  </head>
  <body class="bg-white text-slate">
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Analytics />
    <Footer />
  </body>
</html>
