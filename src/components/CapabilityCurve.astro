---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const phases = [
  { label: "Diagnose", newco: 92, client: 8 },
  { label: "Build With", newco: 74, client: 30 },
  { label: "Run With", newco: 48, client: 58 },
  { label: "Hand Over", newco: 22, client: 82 },
  { label: "Advise", newco: 10, client: 94 },
];

const width = 1120;
const height = compact ? 260 : 320;
const padX = 60;
const padTop = 40;
const padBottom = 56;
const plotHeight = height - padTop - padBottom;
const stepX = (width - padX * 2) / (phases.length - 1);

function toY(value: number) {
  return padTop + plotHeight * (1 - value / 100);
}

function pathFor(key: "newco" | "client") {
  return phases
    .map((phase, i) => `${i === 0 ? "M" : "L"} ${padX + stepX * i} ${toY(phase[key])}`)
    .join(" ");
}

const newcoPath = pathFor("newco");
const clientPath = pathFor("client");
---

<div data-capability-curve>
  <div class="hidden md:block">
    <svg
      viewBox={`0 0 ${width} ${height}`}
      role="img"
      aria-labelledby="capability-curve-title capability-curve-desc"
      class="w-full"
    >
      <title id="capability-curve-title">Capability transfer curve</title>
      <desc id="capability-curve-desc">
        A line chart across five phases — Diagnose, Build With, Run With, Hand Over, Advise — showing NewCo's
        day-to-day ownership decreasing from high to low while the client's ownership increases from low to high.
      </desc>

      {
        phases.map((_phase, i) => (
          <line
            x1={padX + stepX * i}
            y1={padTop}
            x2={padX + stepX * i}
            y2={padTop + plotHeight}
            stroke="var(--color-line)"
            stroke-width="1"
          />
        ))
      }

      <path d={newcoPath} fill="none" stroke="var(--color-graphite)" stroke-width="2.5" data-curve-line />
      <path d={clientPath} fill="none" stroke="var(--color-signal)" stroke-width="2.5" data-curve-line />

      {
        phases.map((phase, i) => (
          <>
            <circle cx={padX + stepX * i} cy={toY(phase.newco)} r="4" fill="var(--color-graphite)" />
            <circle cx={padX + stepX * i} cy={toY(phase.client)} r="4" fill="var(--color-signal)" />
            <text
              x={padX + stepX * i}
              y={height - 20}
              text-anchor="middle"
              class="fill-ink"
              style="font-size: 15px; font-weight: 600;"
            >
              {phase.label}
            </text>
          </>
        ))
      }
    </svg>

    <div class="mt-4 flex items-center gap-6 label text-graphite">
      <span class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-graphite" aria-hidden="true"></span>
        NewCo day-to-day ownership
      </span>
      <span class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-signal" aria-hidden="true"></span>
        Client ownership
      </span>
    </div>
  </div>

  <ol class="flex flex-col gap-4 md:hidden">
    {
      phases.map((phase, i) => (
        <li class="rounded-sm border border-line bg-surface p-4">
          <p class="label text-signal">Phase {i + 1}</p>
          <p class="mt-1 text-h3">{phase.label}</p>
          <div class="mt-3 flex flex-col gap-1 text-body text-graphite">
            <span>NewCo ownership: {phase.newco}%</span>
            <span>Client ownership: {phase.client}%</span>
          </div>
        </li>
      ))
    }
  </ol>

  <p class="mt-6 text-body-lg font-medium text-ink">
    Handover is a success metric&mdash;not a hidden failure condition.
  </p>
</div>
