---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import { Icon } from "astro-icon/components";
import { pad, shell } from "../lib/ui";

const founders = [
  { name: "Vanezza Angelica A", role: "Chief Executive Officer", roleKey: "about.team.role-ceo", alt: "Vanezza Angelica A, Chief Executive Officer", altKey: "about.team.alt-ceo", image: "/images/ceo.webp", bio: "Vanezza leads strategy, client partnerships and operations, backed by a technical background in networking, cybersecurity and AI. A founder with experience in telecommunications and AI startups, she works closely with clients to turn business objectives into clear technical direction.", bioKey: "about.team.bio-ceo" },
  { name: "Agung Denisa", role: "Chief Technology Officer", roleKey: "about.team.role-cto", alt: "Agung Denisa, Chief Technology Officer", altKey: "about.team.alt-cto", image: "/images/cto.webp", bio: "Agung architects the systems Kyron Engineering builds and owns its technical standards, backed by a background in platform engineering, data pipelines and application security. He has run distributed systems on GCP and led penetration-tested releases of an enterprise payment platform.", bioKey: "about.team.bio-cto", linkedin: "https://www.linkedin.com/in/agung78/" },
];

const commitments = [
  { icon: "solar:chat-round-dots-linear", title: "Clear communication.", titleKey: "about.commitments.plain-title", description: "Regular updates in plain language.", descKey: "about.commitments.plain-desc" },
  { icon: "solar:tag-price-linear", title: "Transparent pricing.", titleKey: "about.commitments.pricing-title", description: "Costs agreed before work begins.", descKey: "about.commitments.pricing-desc" },
  {
    icon: "solar:user-speak-linear",
    title: "Dedicated contact.",
    titleKey: "about.commitments.contact-title",
    description: "One point of contact and agreed response times.",
    descKey: "about.commitments.contact-desc",
  },
  {
    icon: "solar:shield-check-linear",
    title: "Independent advice.",
    titleKey: "about.commitments.honest-title",
    description: "We recommend what’s right for the business, not what costs the most.",
    descKey: "about.commitments.honest-desc",
  },
];

const principles = [
  {
    title: "Zero lock-in architecture",
    titleKey: "about.philosophy.p1-title",
    body: "Every architectural decision prioritises open standards, clean APIs and widely used cloud services, so your systems can be run, modified or migrated without proprietary barriers.",
    bodyKey: "about.philosophy.p1-body",
  },
  {
    title: "Continuous documentation",
    titleKey: "about.philosophy.p2-title",
    body: "Architecture decisions, deployment guides and data structures are recorded alongside the source code, so knowledge is never lost when people move on.",
    bodyKey: "about.philosophy.p2-body",
  },
  {
    title: "Maintainable code",
    titleKey: "about.philosophy.p3-title",
    body: "We write software for the engineers who will maintain it years from now. Strict coding standards and automated testing keep it reliable as it grows.",
    bodyKey: "about.philosophy.p3-body",
  },
  {
    title: "Pragmatic innovation",
    titleKey: "about.philosophy.p4-title",
    body: "New tools are assessed on their long-term maintenance cost and measurable business return. We recommend proven, reliable solutions whenever they offer equal or better value.",
    bodyKey: "about.philosophy.p4-body",
  },
];
---

<Layout titleKey="meta.about.title" descKey="meta.about.description" lcpImage="/images/ceo.webp">
  <section class="bg-white">
    <div class:list={[shell, "py-16 md:py-24"]}>
      <span class="mono text-blue" data-hero-item data-i18n="about.hero.eyebrow">// LEADERSHIP &amp; COMMITMENTS</span>
      <div class="mt-6 grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12">
        <h1 class="text-h1 uppercase text-navy text-balance tracking-tight lg:col-span-7 text-reveal" data-i18n="about.hero.title">Built on trust, delivered with care.</h1>
        <p class="text-body-lg text-slate lg:col-span-5 lg:pt-2" data-hero-item data-i18n="about.hero.lede">
          Your technology partner, start to finish. We design, build and support the systems businesses rely on every day.
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-mist py-16 md:py-24">
    <div class={shell}>
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-12 items-start">
        <div class="lg:sticky lg:top-28 lg:col-span-5">
          <h2 class="text-h2 text-navy text-balance text-reveal" data-i18n="about.team.title">Meet the founders.</h2>
          <p class="text-body-lg text-slate mt-4 leading-relaxed" data-i18n="about.team.lede">
            We started Kyron Engineering to give growing businesses a technology partner they can rely on, combining commercial understanding with strong engineering.
          </p>
        </div>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:col-span-7" data-reveal-group>
          {
            founders.map((f, i) => (
              <figure itemscope itemtype="https://schema.org/Person" class="group flex flex-col justify-between rounded-2xl border border-line bg-white p-5 shadow-xs card-hover md:p-6" data-reveal-item>
                <div>
                  <div class="image-animation mx-auto w-full max-w-[200px] sm:max-w-none overflow-hidden rounded-xl border border-line/60 bg-mist">
                    <img
                      src={f.image}
                      alt={f.alt}
                      data-i18n-attr={"alt:" + f.altKey}
                      width="400"
                      height="500"
                      loading="eager"
                      fetchpriority={i === 0 ? "high" : "auto"}
                      decoding="async"
                      class="aspect-[4/5] w-full object-cover object-top"
                      itemprop="image"
                    />
                  </div>
                  <div class="mt-5">
                    <h3 class="text-xl font-semibold text-navy tracking-tight" itemprop="name">{f.name}</h3>
                    <p class="text-sm font-semibold text-blue mt-0.5" data-i18n={f.roleKey} itemprop="jobTitle">{f.role}</p>
                    <p class="text-body text-slate mt-3 leading-relaxed text-sm md:text-base" data-i18n={f.bioKey} itemprop="description">{f.bio}</p>
                  </div>
                </div>
                {f.linkedin && (
                  <div class="mt-5 pt-3 border-t border-line/50">
                    <a href={f.linkedin} class="inline-flex items-center gap-1.5 text-sm font-semibold text-blue underline decoration-blue/50 underline-offset-4 hover:text-blue-dark hover:decoration-blue" target="_blank" rel="noopener" itemprop="sameAs" aria-label={`${f.name} on LinkedIn`}>
                      <span>LinkedIn</span>
                      <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd"/></svg>
                    </a>
                  </div>
                )}
              </figure>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 md:py-24">
    <div class={shell}>
      <h2 class="text-h2 text-navy text-balance text-reveal" data-i18n="about.commitments.title">Our commitments to every client.</h2>
      <ul class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2" data-reveal-group>
        {
          commitments.map((item, i) => (
            <li class="group flex gap-5 rounded-xl border border-line bg-white p-7 shadow-xs card-hover md:p-8" data-reveal-item>
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-blue/5 text-blue transition-colors group-hover:bg-blue/10">
                <Icon name={item.icon} class="h-6 w-6" aria-hidden="true" />
              </div>
              <div>
                <span class="mono text-xs font-semibold text-blue">{pad(i)}</span>
                <h3 class="text-h3 font-semibold text-navy tracking-tight mt-1" data-i18n={item.titleKey}>{item.title}</h3>
                <p class="text-body text-slate mt-2 leading-relaxed" data-i18n={item.descKey}>{item.description}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <div class="mt-16 border-t border-line pt-12">
        <h3 class="text-h3 font-semibold text-navy" data-i18n="about.commitments.work-title">How we work with your team</h3>
        <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-8 text-body text-slate">
          <p data-i18n="about.commitments.work-p1">We work directly with your leadership and any technical staff you have, rather than operating at a distance. Our engineers share progress at every stage, agree on clear standards from day one, and review the work openly with your team.</p>
          <p data-i18n="about.commitments.work-p2">Every architecture decision, infrastructure change and operating procedure is documented as we go. When the engagement ends, your business holds full ownership of its code, systems and deployment processes, along with the knowledge to run them.</p>
        </div>
      </div>
      <div class="mt-12 flex flex-col justify-between gap-6 rounded-xl border border-line bg-mist p-6 md:flex-row md:items-center md:p-8">
        <div>
          <h3 class="text-h3 font-semibold text-navy" data-i18n="about.overview.title">Want a quick overview?</h3>
          <p class="mt-2 max-w-[54ch] text-body text-slate" data-i18n="about.overview.body">
            See how we work, what we deliver and how ownership transfers to you.
          </p>
        </div>
        <Button
          href="/downloads/kyron-engineering-company-overview-en.pdf"
          variant="secondary"
          class="shrink-0"
          target="_blank"
          rel="noopener"
          data-i18n-attr="href:overview.href"
        >
          <span data-i18n="overview.link">View company overview (PDF)</span>
        </Button>
      </div>
    </div>
  </section>

  <section id="philosophy" class="scroll-mt-24 border-t border-line bg-white" aria-labelledby="philosophy-title">
    <div class:list={[shell, "py-16 md:py-24"]}>
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:sticky lg:top-28 lg:col-span-5 lg:self-start">
          <span class="mono text-grey" data-i18n="about.philosophy.eyebrow">// OUR PHILOSOPHY</span>
          <h2 id="philosophy-title" class="mt-4 text-h2 text-navy text-balance text-reveal" data-i18n="about.philosophy.heading">Engineering principles that outlast every engagement.</h2>
          <p class="text-body-lg text-slate max-w-[68ch] mt-4" data-i18n="about.philosophy.lede">
            We believe technology should support business growth without creating long-term dependence on any vendor. These four principles guide how we architect and build.
          </p>
        </div>

        <div class="corners overflow-hidden rounded-xl border border-line bg-white shadow-xs lg:col-span-7">
          <table class="w-full text-left border-collapse tabular-nums">
            <caption class="sr-only" data-i18n="about.philosophy.heading">Engineering principles that outlast every engagement.</caption>
            <thead>
              <tr class="border-b border-line bg-mist/80">
                <th scope="col" class="mono w-2/5 px-4 py-4 text-xs font-semibold tracking-wider uppercase text-navy md:w-5/12 md:px-6" data-i18n="about.philosophy.col-principle">Principle</th>
                <th scope="col" class="mono px-4 py-4 text-xs font-semibold tracking-wider uppercase text-navy md:px-6" data-i18n="about.philosophy.col-how">How we apply it</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line" data-reveal-group>
              {
                principles.map((row, i) => (
                  <tr class="transition-colors hover:bg-mist/40" data-reveal-item>
                    <th scope="row" class="px-4 py-4.5 align-top text-left font-semibold text-navy md:px-6">
                      <span class="mono mr-2 text-xs text-blue">{pad(i)}</span><span data-i18n={row.titleKey}>{row.title}</span>
                    </th>
                    <td class="px-4 py-4.5 text-slate leading-relaxed md:px-6" data-i18n={row.bodyKey}>{row.body}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-mist">
    <div class:list={[shell, "py-16 md:py-24"]}>
      <div class="corners rounded-xl border border-line bg-white p-8 md:p-16" data-tagline-reveal>
        <div class="grid grid-cols-1 items-end gap-8 lg:grid-cols-12 lg:gap-12">
          <div class="lg:col-span-8">
            <h2 class="max-w-[24ch] text-h2 text-navy text-balance text-reveal" data-i18n="about.cta.title">
              Tell us where your technology stands today.
            </h2>
            <p class="mt-6 max-w-[68ch] text-body text-slate text-pretty" data-i18n="about.cta.body">
              We'll look at your systems, constraints and goals, then give you an honest recommendation on the best way forward.
            </p>
          </div>
          <div class="lg:col-span-4 lg:justify-self-end">
            <Button href="/contact" variant="primary" class="md:whitespace-nowrap"><span data-i18n="about.cta.button">Talk to us</span></Button>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
