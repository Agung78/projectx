---
const links = [
  { href: "/how-we-work", label: "How we work" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
  { href: "/privacy", label: "Privacy" },
];
---

<footer class="border-t border-white/10 bg-[#0F2A4A] text-white">
  <div class="mx-auto max-w-content px-[clamp(20px,5vw,80px)] py-16">
    <div class="grid gap-12 md:grid-cols-[1.2fr_1fr]">
      <div class="max-w-measure">
        <p class="text-h3 font-semibold text-white">NewCo</p>
        <p class="mt-4 text-body text-white/70">
          Systems built properly, documented fully, and owned by the business.
        </p>
        <address class="mt-8 text-body not-italic text-white/70">
          <p class="font-medium text-white">PT NewCo Teknologi Indonesia</p>
          <p class="mt-1">
            One Pacific Place, Level 11, SCBD, Jl. Jend. Sudirman Kav. 52-53, Jakarta Selatan 12190, Indonesia
          </p>
          <p class="mt-1">NIB / Company Registration: 0120202688192</p>
        </address>
      </div>

      <nav aria-label="Footer" class="flex flex-col gap-3">
        {
          links.map((link) => (
            <a href={link.href} class="text-body text-white/70 hover:text-white">
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="mt-12 border-t border-white/10 pt-6 text-body text-white/60">
      <p>&copy; {new Date().getFullYear()} NewCo. All rights reserved.</p>
    </div>
  </div>
</footer>
