---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
---

<Layout titleKey="meta.contact.title" descKey="meta.contact.description">
  <section class="mx-auto max-w-[1200px] px-4 md:px-6 py-14 md:py-24">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-12">
      <div class="lg:sticky lg:top-28 lg:col-span-5 lg:self-start">
        <div class="rounded-2xl border border-line bg-white p-7 shadow-xs md:p-9" data-hero-item>
          <span class="mono text-xs font-semibold text-blue" data-i18n="contact.intro.eyebrow">// ENGAGEMENT BRIEF</span>
          <h1 class="mt-4 text-h1 uppercase text-navy text-balance tracking-tight text-reveal" data-i18n="contact.intro.title">Tell us what the business needs.</h1>
          <p class="text-body text-slate max-w-[68ch] mt-4 leading-relaxed" data-i18n="contact.intro.lede">
            Share a few details and we'll reply with a clear next step. No obligation, and we'll never ask for passwords or system access here.
          </p>

          <div class="mt-8 border-t border-line pt-6">
            <h2 class="text-xs font-semibold tracking-wider text-navy uppercase mono" data-i18n="contact.intro.review-title">// Direct Founder Review</h2>
            <p class="mt-2 text-sm text-slate leading-relaxed" data-i18n="contact.intro.review-body">Every enquiry is reviewed directly by our founders, with a guaranteed 24-hour response.</p>
            <h3 class="text-xs font-semibold tracking-wider text-navy uppercase mono mt-6" data-i18n="contact.intro.expect-title">// What to expect</h3>
            <ul class="mt-3 flex flex-col gap-2.5 text-sm text-slate list-disc pl-4 leading-relaxed">
              <li data-i18n="contact.intro.expect-1">An initial 30-minute scoping call to understand your systems and constraints.</li>
              <li data-i18n="contact.intro.expect-2">Clear technical recommendations and capability baseline assessment.</li>
              <li data-i18n="contact.intro.expect-3">Honest fit evaluation: we only take on engagements where we can ensure complete handover.</li>
            </ul>
          </div>

          <p class="mt-6 border-t border-line/60 pt-4 text-xs text-grey"><span data-i18n="contact.intro.privacy-prefix">We respect your privacy. See our</span> <a href="/privacy/" class="underline hover:text-navy" data-i18n="contact.intro.privacy-link">Privacy Policy</a><span data-i18n="contact.intro.privacy-suffix">.</span></p>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="rounded-2xl border border-line bg-white p-6 shadow-xs md:p-10" data-hero-item>
          <div class="mb-6 flex items-center justify-between border-b border-line pb-4">
            <span class="mono text-xs font-semibold text-blue" data-i18n="contact.form.console">// GET IN TOUCH</span>
          </div>
          <form
            id="contact-form"
            method="post"
            novalidate
            class="flex flex-col gap-7"
            data-contact-form
          >
          <div class="absolute -left-[9999px] opacity-0 pointer-events-none" aria-hidden="true" tabindex="-1">
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-label="Leave this field empty" />
            <input type="hidden" name="_ts" value="" />
          </div>
            <div class="grid gap-6 md:grid-cols-2">
              <div class="flex flex-col gap-2">
                <label for="name" class="text-sm font-semibold text-slate"><span data-i18n="contact.form.name-label">Your name</span><span aria-hidden="true"> *</span></label>
                <input id="name" name="name" type="text" required autocomplete="name"
                  class="rounded-[8px] border border-field bg-white px-4 py-3 text-body text-navy focus:border-blue focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
                  aria-describedby="name-error" />
                <p id="name-error" class="hidden text-body text-red" role="alert"></p>
              </div>
              <div class="flex flex-col gap-2">
                <label for="company" class="text-sm font-semibold text-slate"><span data-i18n="contact.form.company-label">Company</span><span aria-hidden="true"> *</span></label>
                <input id="company" name="company" type="text" required autocomplete="organization"
                  class="rounded-[8px] border border-field bg-white px-4 py-3 text-body text-navy focus:border-blue focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
                  aria-describedby="company-error" />
                <p id="company-error" class="hidden text-body text-red" role="alert"></p>
              </div>
              <div class="flex flex-col gap-2">
                <label for="role" class="text-sm font-semibold text-slate"><span data-i18n="contact.form.role-label">Your role</span><span aria-hidden="true"> *</span></label>
                <input id="role" name="role" type="text" required autocomplete="organization-title"
                  class="rounded-[8px] border border-field bg-white px-4 py-3 text-body text-navy focus:border-blue focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
                  aria-describedby="role-error" />
                <p id="role-error" class="hidden text-body text-red" role="alert"></p>
              </div>
              <div class="flex flex-col gap-2">
                <label for="email" class="text-sm font-semibold text-slate"><span data-i18n="contact.form.email-label">Email</span><span aria-hidden="true"> *</span></label>
                <input id="email" name="email" type="email" required autocomplete="email"
                  class="rounded-[8px] border border-field bg-white px-4 py-3 text-body text-navy focus:border-blue focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
                  aria-describedby="email-error" />
                <p id="email-error" class="hidden text-body text-red" role="alert"></p>
              </div>
              <div class="flex flex-col gap-2">
                <label for="region" class="text-sm font-semibold text-slate"><span data-i18n="contact.form.region-label">Country or region</span><span aria-hidden="true"> *</span></label>
                <div class="country-combo relative" data-country-combo>
                  <span class="country-flag pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-xl leading-none" data-country-flag aria-hidden="true"></span>
                  <input id="region" name="region" type="text" required autocomplete="off" role="combobox"
                    aria-autocomplete="list" aria-expanded="false" aria-controls="region-list" spellcheck="false"
                    class="w-full rounded-[8px] border border-field bg-white py-3 pl-4 pr-11 text-body text-navy focus:border-blue focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
                    aria-describedby="region-error" />
                  <svg class="country-chevron pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 8 5 5 5-5" /></svg>
                  <ul id="region-list" role="listbox" class="country-list" data-country-list data-lenis-prevent hidden><li role="option" class="hidden" aria-hidden="true"></li></ul>
                </div>
                <p id="region-error" class="hidden text-body text-red" role="alert"></p>
              </div>
              <div class="flex flex-col gap-2">
                <label for="locations" class="text-sm font-semibold text-slate"><span data-i18n="contact.form.locations-label">How many locations or branches?</span><span aria-hidden="true"> *</span></label>
                <div class="country-combo relative" data-select-combo>
                  <input id="locations" name="locations" type="text" required readonly autocomplete="off" role="combobox"
                    aria-expanded="false" aria-controls="locations-list" aria-describedby="locations-error"
                    class="w-full cursor-pointer rounded-[8px] border border-field bg-white py-3 pl-4 pr-11 text-body text-navy focus:border-blue focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue" />
                  <svg class="country-chevron pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 8 5 5 5-5" /></svg>
                  <ul id="locations-list" role="listbox" class="country-list" data-select-list data-lenis-prevent hidden><li role="option" class="hidden" aria-hidden="true"></li></ul>
                </div>
                <p id="locations-error" class="hidden text-body text-red" role="alert"></p>
              </div>
        </div>

        <div class="flex flex-col gap-2">
          <label for="help" class="text-sm font-semibold text-slate"><span data-i18n="contact.form.help-label">What would you like help with?</span><span aria-hidden="true"> *</span></label>
          <textarea id="help" name="help" required rows="4"
            class="rounded-[8px] border border-field bg-white px-4 py-3 text-body text-navy focus:border-blue focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
            aria-describedby="help-error"></textarea>
          <p id="help-error" class="hidden text-body text-red" role="alert"></p>
        </div>

        <fieldset class="flex flex-col gap-2.5" aria-describedby="follow_up-error">
          <legend class="text-sm font-semibold text-slate"><span data-i18n="contact.form.followup-label">How should we follow up?</span><span aria-hidden="true"> *</span></legend>
          <div class="flex flex-col gap-2.5 md:flex-row md:gap-4">
            {
              ["Email", "Phone", "Video call"].map((option, idx) => (
                <label class="flex flex-1 cursor-pointer items-center gap-2.5 rounded-lg border border-field/50 bg-white px-4 py-2.5 text-body text-navy transition-all hover:border-field has-[:checked]:border-blue has-[:checked]:bg-blue/5 has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-blue">
                  <input type="radio" name="follow_up" value={option} required class="accent-blue" />
                  <span class="text-sm font-semibold" data-i18n={["contact.form.followup-email", "contact.form.followup-phone", "contact.form.followup-videocall"][idx]}>{option}</span>
                </label>
              ))
            }
          </div>
          <p id="follow_up-error" class="hidden text-body text-red" role="alert"></p>
        </fieldset>

        <details class="rounded-xl border border-line bg-mist/60 p-4 transition-colors hover:bg-mist" data-accordion>
          <summary class="cursor-pointer text-sm font-semibold text-navy select-none" data-i18n="contact.form.more-title">A bit more (optional)</summary>
          <div class="mt-4 grid gap-6 md:grid-cols-2" data-accordion-content>
              <div class="flex flex-col gap-2">
                <label for="project_type" class="text-sm font-semibold text-slate" data-i18n="contact.form.project-label">What best describes the project?</label>
                <select id="project_type" name="project_type" class="rounded-[8px] border border-field bg-white px-4 py-3 text-body text-navy focus:border-blue focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue">
                  <option value="" data-i18n="contact.form.project-placeholder">Select one</option>
                  <option value="New system" data-i18n="contact.form.project-new">New system</option>
                  <option value="Improve an existing system" data-i18n="contact.form.project-improve">Improve an existing system</option>
                  <option value="Not sure yet" data-i18n="contact.form.project-unsure">Not sure yet</option>
                </select>
              </div>
              <div class="flex flex-col gap-2">
              <label for="decision_maker" class="text-sm font-semibold text-slate" data-i18n="contact.form.decision-label">Who's the main decision-maker?</label>
              <input id="decision_maker" name="decision_maker" type="text"
                class="rounded-[8px] border border-field bg-white px-4 py-3 text-body text-navy focus:border-blue focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue" />
              </div>
              <div class="flex flex-col gap-2">
              <label for="it_contact" class="text-sm font-semibold text-slate" data-i18n="contact.form.it-label">Is there an IT contact or provider we should speak with?</label>
              <input id="it_contact" name="it_contact" type="text"
                class="rounded-[8px] border border-field bg-white px-4 py-3 text-body text-navy focus:border-blue focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue" />
              </div>
          </div>
        </details>

        <Button type="submit" variant="primary" class="mt-2 w-fit justify-center md:whitespace-nowrap" data-submit-button>
          <span data-button-label data-i18n="contact.form.submit">Send</span>
        </Button>

      </form>
      <p data-form-status tabindex="-1" class="hidden text-body outline-offset-4" role="status"></p>
      </div>
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-mist py-16 md:py-24">
    <div class="mx-auto max-w-[1200px] px-4 md:px-6">
      <div class="max-w-[68ch]">
        <span class="mono text-blue" data-i18n="contact.faq.eyebrow">// ENGAGEMENT FAQ</span>
        <h2 class="mt-4 text-h2 text-navy text-balance" data-i18n="contact.faq.heading">Common questions before reaching out.</h2>
        <p class="mt-4 text-body-lg text-slate" data-i18n="contact.faq.lede">
          Here is what working with Kyron Engineering looks like from initial conversation to contractual handover.
        </p>
      </div>

      <ol class="mt-12 border-t border-navy divide-y divide-line">
        <li class="grid grid-cols-1 gap-3 py-8 transition-colors hover:bg-white/40 md:grid-cols-[4rem_1fr_1.4fr] md:gap-8">
          <span class="mono text-xs font-semibold text-blue md:text-sm">01</span>
          <h3 class="text-h3 font-semibold text-navy text-balance tracking-tight" data-i18n="contact.faq.q1-title">What happens after submitting the form?</h3>
          <p class="text-body text-slate leading-relaxed" data-i18n="contact.faq.q1-body">
            Within 24 business hours, our founders review your details and send a direct response. If there is mutual alignment, we schedule a 30-minute discovery conversation to discuss architecture, timeline, and goals.
          </p>
        </li>
        <li class="grid grid-cols-1 gap-3 py-8 transition-colors hover:bg-white/40 md:grid-cols-[4rem_1fr_1.4fr] md:gap-8">
          <span class="mono text-xs font-semibold text-blue md:text-sm">02</span>
          <h3 class="text-h3 font-semibold text-navy text-balance tracking-tight" data-i18n="contact.faq.q2-title">Do you sign non-disclosure agreements?</h3>
          <p class="text-body text-slate leading-relaxed" data-i18n="contact.faq.q2-body">
            Yes. We routinely execute mutual NDAs prior to reviewing proprietary source code, infrastructure credentials, or sensitive business logic. Your intellectual property remains strictly yours.
          </p>
        </li>
        <li class="grid grid-cols-1 gap-3 py-8 transition-colors hover:bg-white/40 md:grid-cols-[4rem_1fr_1.4fr] md:gap-8">
          <span class="mono text-xs font-semibold text-blue md:text-sm">03</span>
          <h3 class="text-h3 font-semibold text-navy text-balance tracking-tight" data-i18n="contact.faq.q3-title">What types of projects do you take on?</h3>
          <p class="text-body text-slate leading-relaxed" data-i18n="contact.faq.q3-body">
            We partner on core web platforms, enterprise distributed systems, cloud migrations, performance overhauls, and modernization of legacy codebases where client teams require long-term independence.
          </p>
        </li>
        <li class="grid grid-cols-1 gap-3 py-8 transition-colors hover:bg-white/40 md:grid-cols-[4rem_1fr_1.4fr] md:gap-8">
          <span class="mono text-xs font-semibold text-blue md:text-sm">04</span>
          <h3 class="text-h3 font-semibold text-navy text-balance tracking-tight" data-i18n="contact.faq.q4-title">How does pricing and billing work?</h3>
          <p class="text-body text-slate leading-relaxed" data-i18n="contact.faq.q4-body">
            Engagements are scoped with fixed, transparent milestones or predictable monthly retainers. You receive clear deliverables with no unexpected billing or hidden maintenance fees.
          </p>
        </li>
        <li class="grid grid-cols-1 gap-3 py-8 transition-colors hover:bg-white/40 md:grid-cols-[4rem_1fr_1.4fr] md:gap-8">
          <span class="mono text-xs font-semibold text-blue md:text-sm">05</span>
          <h3 class="text-h3 font-semibold text-navy text-balance tracking-tight" data-i18n="contact.faq.q5-title">Can we start with a pilot engagement?</h3>
          <p class="text-body text-slate leading-relaxed" data-i18n="contact.faq.q5-body">
            Yes. Many clients begin with a two-week baseline diagnostic or targeted architecture audit. This gives your team a clear, actionable roadmap and proof of collaboration before committing to full-scale build sprints.
          </p>
        </li>
        <li class="grid grid-cols-1 gap-3 py-8 transition-colors hover:bg-white/40 md:grid-cols-[4rem_1fr_1.4fr] md:gap-8">
          <span class="mono text-xs font-semibold text-blue md:text-sm">06</span>
          <h3 class="text-h3 font-semibold text-navy text-balance tracking-tight" data-i18n="contact.faq.q6-title">How do you collaborate with our team?</h3>
          <p class="text-body text-slate leading-relaxed" data-i18n="contact.faq.q6-body">
            We integrate directly into your existing communication tools, participate in sprint rituals, and submit changes through pull requests. Knowledge transfer happens continuously through daily code reviews.
          </p>
        </li>
      </ol>
    </div>
  </section>
</Layout>

<script>
  import { STRINGS } from "../i18n/dictionary";
  import { trackEvent } from "../lib/posthog";

  type Lang = "en" | "id";
  function getLang(): Lang {
    return (document.documentElement.lang === "id" ? "id" : "en");
  }
  function t(key: string): string {
    const lang = getLang();
    return STRINGS[key]?.[lang] ?? STRINGS[key]?.en ?? key;
  }
  function revalidateVisibleErrors(form: HTMLFormElement) {
    const invalid = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[aria-invalid='true']"));
    invalid.forEach((field) => {
      const errorEl = document.getElementById(field.getAttribute("aria-describedby") ?? "");
      if (!errorEl || errorEl.classList.contains("hidden")) return;
      const key = errorEl.dataset.i18n;
      if (key) errorEl.textContent = t(key);
    });
    const radioError = document.getElementById("follow_up-error");
    if (radioError && !radioError.classList.contains("hidden") && radioError.dataset.i18n) {
      radioError.textContent = t(radioError.dataset.i18n);
    }
    const status = document.querySelector<HTMLElement>("[data-form-status]");
    if (status && !status.classList.contains("hidden") && status.dataset.i18n) {
      status.textContent = t(status.dataset.i18n);
    }
    const sendingLabel = form.querySelector<HTMLElement>("[data-button-label]");
    if (sendingLabel?.dataset.i18n) sendingLabel.textContent = t(sendingLabel.dataset.i18n);
  }
  function initContactForm() {
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  if (form) {
    const submitButton = form.querySelector<HTMLButtonElement>("[data-submit-button]");
    const buttonLabel = form.querySelector<HTMLElement>("[data-button-label]");
     const status = document.querySelector<HTMLElement>("[data-form-status]");
    const tsInput = form.querySelector<HTMLInputElement>('input[name="_ts"]');
    if (tsInput) tsInput.value = Date.now().toString();

    const requiredFields = Array.from(
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[required]")
    );

    const messageKeys: Record<string, string> = {
      name: "contact.form.err-name",
      company: "contact.form.err-company",
      role: "contact.form.err-role",
      email: "contact.form.err-email",
      region: "contact.form.err-region",
      locations: "contact.form.err-locations",
      help: "contact.form.err-help",
    };

    function showError(field: HTMLInputElement | HTMLTextAreaElement, key: string) {
      const errorId = field.getAttribute("aria-describedby");
      if (!errorId) return;
      const errorEl = document.getElementById(errorId);
      if (errorEl) {
        errorEl.dataset.i18n = key;
        errorEl.textContent = t(key);
        errorEl.classList.remove("hidden");
      }
      field.setAttribute("aria-invalid", "true");
    }

    function clearError(field: HTMLInputElement | HTMLTextAreaElement) {
      const errorId = field.getAttribute("aria-describedby");
      if (!errorId) return;
      const errorEl = document.getElementById(errorId);
      if (errorEl) {
        errorEl.textContent = "";
        errorEl.classList.add("hidden");
        delete errorEl.dataset.i18n;
      }
      field.removeAttribute("aria-invalid");
    }

    function validateRadioGroup(): boolean {
      const checked = form?.querySelector<HTMLInputElement>('input[name="follow_up"]:checked');
      const errorEl = document.getElementById("follow_up-error");
      if (!checked && errorEl) {
        errorEl.dataset.i18n = "contact.form.err-followup";
        errorEl.textContent = t("contact.form.err-followup");
        errorEl.classList.remove("hidden");
        return false;
      }
      if (errorEl) delete errorEl.dataset.i18n;
      errorEl?.classList.add("hidden");
      return true;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      let valid = true;

      requiredFields.forEach((field) => {
        if (field.type === "radio") return;
        if (!field.value.trim()) {
          showError(field, messageKeys[field.name] ?? "contact.form.err-required");
          valid = false;
        } else if (field.name === "region" && field.dataset.noMatch === "1") {
          showError(field, "contact.form.err-region-invalid");
          valid = false;
        } else if (field.type === "email" && !/^\S+@\S+\.\S+$/.test(field.value)) {
          showError(field, "contact.form.err-email-invalid");
          valid = false;
        } else {
          clearError(field);
        }
      });

      if (!validateRadioGroup()) valid = false;

      if (!valid) {
        form.querySelector<HTMLElement>('[aria-invalid="true"], input:invalid')?.focus();
        return;
      }

      if (submitButton && buttonLabel && status) {
        submitButton.disabled = true;
        buttonLabel.dataset.i18n = "contact.form.sending";
        buttonLabel.textContent = t("contact.form.sending");
        status.classList.add("hidden");

        const formData = Object.fromEntries(new FormData(form).entries());

        try {
          const response = await fetch("/api/contact/", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify(formData),
          });

          const result = await response.json().catch(() => ({}));

          if (response.ok) {
            trackEvent("contact_form_submitted", {
              role: formData.role ? String(formData.role) : undefined,
              region: formData.region ? String(formData.region) : undefined,
              has_company: Boolean(formData.company),
            });
            form.hidden = true;
            status.classList.remove("hidden");
            status.dataset.i18n = "contact.form.success";
            status.textContent = t("contact.form.success");
            status.classList.add("text-green", "text-body-lg", "font-semibold");
            requestAnimationFrame(() => {
              status.dataset.visible = "true";
              status.focus();
            });
          } else {
            throw new Error(result.error ?? `Request failed (${response.status})`);
          }
        } catch (error) {
          trackEvent("contact_form_error", {
            error: error instanceof Error ? error.message : "unknown",
          });
          status.classList.remove("hidden");
          status.textContent =
            error instanceof Error ? error.message : "Something went wrong. Please try again.";
          status.classList.add("text-red", "text-body-lg", "font-semibold");
          requestAnimationFrame(() => {
            status.dataset.visible = "true";
            status.focus();
          });
        } finally {
          submitButton.disabled = false;
          buttonLabel.dataset.i18n = "contact.form.submit";
          buttonLabel.textContent = t("contact.form.submit");
        }
      }
    });

    requiredFields.forEach((field) => {
      field.addEventListener("input", () => clearError(field));
    });
  }
  }

  function initAccordions() {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const DURATION = 260;
    const EASING = "cubic-bezier(0.23, 1, 0.32, 1)";

    document.querySelectorAll<HTMLDetailsElement>("details[data-accordion]").forEach((details) => {
      if (details.dataset.bound === "true") return;
      details.dataset.bound = "true";

      const summary = details.querySelector("summary");
      const content = details.querySelector<HTMLElement>("[data-accordion-content]");
      if (!summary || !content) return;
      let animation: Animation | null = null;

      const snapshot = () => {
        const style = getComputedStyle(content);
        return { height: style.height, opacity: style.opacity, marginTop: style.marginTop };
      };

      const run = (opening: boolean) => {
        // Capture the live values so a mid-animation toggle reverses from where it is.
        const from = animation
          ? snapshot()
          : opening
            ? { height: "0px", opacity: "0", marginTop: "0px" }
            : null;
        animation?.cancel();

        if (opening) {
          details.open = true;
          delete details.dataset.closing;
        } else {
          details.dataset.closing = "true";
        }

        const natural = snapshot();
        const collapsed = { height: "0px", opacity: "0", marginTop: "0px" };
        const start = from ?? natural;
        const end = opening ? natural : collapsed;

        content.style.overflow = "hidden";
        const current = content.animate([start, end], {
          duration: DURATION,
          easing: EASING,
          fill: "forwards",
        });
        animation = current;

        current.onfinish = () => {
          if (animation !== current) return;
          animation = null;
          if (!opening) {
            details.open = false;
            delete details.dataset.closing;
          }
          current.cancel();
          content.style.overflow = "";
        };
        // A cancelled animation was superseded by a newer toggle, which owns cleanup.
      };

      summary.addEventListener("click", (event) => {
        if (reducedMotion.matches) {
          delete details.dataset.closing;
          return;
        }
        event.preventDefault();
        const isOpen = details.open && !details.dataset.closing;
        run(!isOpen);
      });
    });
  }

  document.addEventListener("astro:page-load", initContactForm);
  document.addEventListener("astro:page-load", initAccordions);
  document.addEventListener("kyron:lang-change", () => {
    const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
    if (form) revalidateVisibleErrors(form);
  });
</script>

<style is:global>
  .country-list {
    position: absolute; z-index: 30; left: 0; right: 0; top: calc(100% + 6px);
    max-height: 16rem; overflow-y: auto; overscroll-behavior: contain; margin: 0; padding: 6px; list-style: none;
    background: #fff; border: 1px solid var(--color-field, #8b93a7); border-radius: 12px;
    box-shadow: 0 12px 32px -8px rgb(15 23 42 / 0.22);
    transform-origin: top; opacity: 0; transform: translateY(-6px) scale(0.98);
    transition: opacity 160ms ease, transform 160ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .country-list[data-open="true"] { opacity: 1; transform: none; }
  .country-list li {
    display: flex; align-items: center; gap: 10px; padding: 9px 10px; border-radius: 8px;
    cursor: pointer; transition: background-color 120ms ease, transform 120ms ease;
  }
  .country-list li[aria-selected="true"] { background: rgb(37 99 235 / 0.1); transform: translateX(2px); }
  .country-list li .flag { font-size: 1.25rem; line-height: 1; }
  .country-list li mark { background: none; color: inherit; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .country-list .empty { cursor: default; color: #64748b; }
  .country-chevron { transition: transform 200ms ease; }
  .country-combo[data-open="true"] .country-chevron { transform: translateY(-50%) rotate(180deg); }
  .country-flag { transition: opacity 150ms ease, transform 200ms cubic-bezier(0.2, 0.8, 0.2, 1); opacity: 0; transform: translateY(-50%) scale(0.6); }
  .country-flag.on { opacity: 1; transform: translateY(-50%) scale(1); }
  .country-combo[data-flag="true"] input { padding-left: 3rem; }
  .country-combo input { transition: padding-left 200ms ease, border-color 150ms ease; }
  @media (prefers-reduced-motion: reduce) {
    .country-list, .country-list li, .country-chevron, .country-flag, .country-combo input { transition: none; }
  }
</style>

<script>
  type C = { name: string; flag: string; code: string };
  const KEY = "countries.v2";
  const API = "https://countries.dev/countries"; // apicountries.com 301s here
  let cache: Promise<C[]> | null = null;

  function load(): Promise<C[]> {
    cache ??= (async () => {
      try {
        const s = sessionStorage.getItem(KEY);
        if (s) return JSON.parse(s) as C[];
      } catch {}
      const r = await fetch(API);
      if (!r.ok) throw new Error(String(r.status));
      const list: C[] = (await r.json()).map((c: C & { alpha2Code: string }) => ({ name: c.name, flag: c.flag, code: c.alpha2Code }))
        .sort((a: C, b: C) => a.name.localeCompare(b.name));
      try { sessionStorage.setItem(KEY, JSON.stringify(list)); } catch {}
      return list;
    })().catch(() => { cache = null; return []; }); // empty => plain text input fallback
    return cache;
  }

  function init() {
    const root = document.querySelector<HTMLElement>("[data-country-combo]");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "1";
    const input = root.querySelector<HTMLInputElement>("input")!;
    const list = root.querySelector<HTMLUListElement>("[data-country-list]")!;
    const flagEl = root.querySelector<HTMLElement>("[data-country-flag]")!;
    let items: C[] = [], active = -1, closeTimer = 0;

    const setFlag = () => {
      load().then((all) => {
        const value = input.value.trim().toLowerCase();
        const hit = all.find((c) => c.name.toLowerCase() === value || c.code.toLowerCase() === value);
        flagEl.textContent = hit?.flag ?? "";
        flagEl.classList.toggle("on", !!hit);
        root.dataset.flag = hit ? "true" : "false";
        // list-only when the API loaded; empty list => free-text fallback
        input.dataset.noMatch = all.length && input.value.trim() && !hit ? "1" : "";
      });
    };
    const setActive = (i: number) => {
      active = i;
      list.querySelectorAll("li[role=option]").forEach((li, n) => {
        li.setAttribute("aria-selected", String(n === i));
        if (n === i) { input.setAttribute("aria-activedescendant", li.id); li.scrollIntoView({ block: "nearest" }); }
      });
    };
    const open = () => {
      clearTimeout(closeTimer);
      list.hidden = false;
      requestAnimationFrame(() => (list.dataset.open = "true"));
      root.dataset.open = "true";
      input.setAttribute("aria-expanded", "true");
    };
    const close = () => {
      list.dataset.open = "false"; root.dataset.open = "false";
      input.setAttribute("aria-expanded", "false"); input.removeAttribute("aria-activedescendant");
      closeTimer = window.setTimeout(() => (list.hidden = true), 170);
    };
    const choose = (c: C) => {
      input.value = c.name;
      input.dispatchEvent(new Event("input", { bubbles: true })); // clears validation errors
      setFlag(); close();
    };
    const render = async () => {
      const all = await load();
      const q = input.value.trim().toLowerCase();
      items = (q ? all.filter((c) => c.name.toLowerCase().includes(q) || c.code.toLowerCase() === q) : all).slice(0, 60);
      if (!items.length) {
        const empty = document.createElement("li");
        empty.className = "empty";
        empty.setAttribute("role", "presentation");
        empty.textContent = "No country found";
        list.replaceChildren(empty);
      } else {
        list.replaceChildren(...items.map((c, i) => {
          const li = document.createElement("li");
          li.setAttribute("role", "option");
          li.id = `region-opt-${i}`;
          li.dataset.i = String(i);
          li.setAttribute("aria-selected", "false");

          const flag = document.createElement("span");
          flag.className = "flag";
          flag.setAttribute("aria-hidden", "true");
          flag.textContent = c.flag;

          const label = document.createElement("span");
          const n = c.name, k = q ? n.toLowerCase().indexOf(q) : -1;
          if (k >= 0) {
            label.append(n.slice(0, k));
            const match = document.createElement("mark");
            match.textContent = n.slice(k, k + q.length);
            label.append(match, n.slice(k + q.length));
          } else {
            label.textContent = n;
          }

          li.append(flag, label);
          return li;
        }));
      }
      setActive(items.length && q ? 0 : -1);
    };

    input.addEventListener("focus", () => { render().then(open); });
    input.addEventListener("input", () => { render().then(open); setFlag(); });
    input.addEventListener("blur", () => { setTimeout(close, 100); setFlag(); });
    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        e.preventDefault();
        if (list.hidden) render().then(open);
        const d = e.key === "ArrowDown" ? 1 : -1;
        setActive((active + d + items.length) % (items.length || 1));
      } else if (e.key === "Enter" && !list.hidden && active >= 0) {
        e.preventDefault(); choose(items[active]);
      } else if (e.key === "Escape") close();
    });
    list.addEventListener("mousedown", (e) => {
      e.preventDefault(); // keep input focus
      const li = (e.target as HTMLElement).closest<HTMLElement>("li[data-i]");
      if (li) choose(items[+li.dataset.i!]);
    });
    list.addEventListener("mousemove", (e) => {
      const li = (e.target as HTMLElement).closest<HTMLElement>("li[data-i]");
      if (li && +li.dataset.i! !== active) setActive(+li.dataset.i!);
    });
    load(); // warm cache so first open is instant
  }
  document.addEventListener("astro:page-load", init);
  init();

  // Locations: 1-9 or "More than 10" (reuses .country-list styles)
  function initSelect() {
    const root = document.querySelector<HTMLElement>("[data-select-combo]");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "1";
    const input = root.querySelector<HTMLInputElement>("input")!;
    const list = root.querySelector<HTMLUListElement>("[data-select-list]")!;
    const opts = [..."123456789"].concat("More than 10");
    list.replaceChildren(...opts.map((o, i) => {
      const li = document.createElement("li");
      li.setAttribute("role", "option");
      li.id = `loc-opt-${i}`;
      li.dataset.i = String(i);
      li.setAttribute("aria-selected", "false");
      const label = document.createElement("span");
      label.textContent = o;
      li.append(label);
      return li;
    }));
    let active = -1, t = 0;
    const setActive = (i: number) => {
      active = i;
      list.querySelectorAll("li").forEach((li, n) => {
        li.setAttribute("aria-selected", String(n === i));
        if (n === i) { input.setAttribute("aria-activedescendant", li.id); li.scrollIntoView({ block: "nearest" }); }
      });
    };
    const open = () => {
      clearTimeout(t); list.hidden = false;
      requestAnimationFrame(() => (list.dataset.open = "true"));
      root.dataset.open = "true"; input.setAttribute("aria-expanded", "true");
      setActive(Math.max(0, opts.indexOf(input.value)));
    };
    const close = () => {
      list.dataset.open = "false"; root.dataset.open = "false";
      input.setAttribute("aria-expanded", "false"); input.removeAttribute("aria-activedescendant");
      t = window.setTimeout(() => (list.hidden = true), 170);
    };
    const choose = (i: number) => {
      input.value = opts[i];
      input.dispatchEvent(new Event("input", { bubbles: true })); // clears validation error
      close();
    };
    input.addEventListener("click", () => (list.hidden || list.dataset.open === "false" ? open() : close()));
    input.addEventListener("blur", () => setTimeout(close, 100));
    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        e.preventDefault();
        if (list.hidden) return open();
        setActive((active + (e.key === "ArrowDown" ? 1 : -1) + opts.length) % opts.length);
      } else if ((e.key === "Enter" || e.key === " ") && !list.hidden && active >= 0) {
        e.preventDefault(); choose(active);
      } else if ((e.key === "Enter" || e.key === " ") && list.hidden) {
        e.preventDefault(); open();
      } else if (e.key === "Escape") close();
    });
    list.addEventListener("mousedown", (e) => {
      e.preventDefault();
      const li = (e.target as HTMLElement).closest<HTMLElement>("li[data-i]");
      if (li) choose(+li.dataset.i!);
    });
    list.addEventListener("mousemove", (e) => {
      const li = (e.target as HTMLElement).closest<HTMLElement>("li[data-i]");
      if (li && +li.dataset.i! !== active) setActive(+li.dataset.i!);
    });
  }
  document.addEventListener("astro:page-load", initSelect);
  initSelect();
</script>
