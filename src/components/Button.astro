---
type BaseProps = {
  variant?: "primary" | "secondary";
  class?: string;
  [attr: string]: unknown;
};

type Props =
  | (BaseProps & { href: string; type?: never })
  | (BaseProps & { href?: never; type: "submit" | "button"; disabled?: boolean });

const { variant = "primary", class: className = "", href, type, disabled, ...rest } = Astro.props;

const base =
  "inline-flex items-center gap-2 rounded-sm px-[18px] py-3 text-body font-medium transition-[color,background-color,transform] duration-[var(--duration-press)] ease-[var(--ease-out)] active:scale-[0.97] disabled:opacity-60 disabled:active:scale-100";
const variants = {
  primary: "bg-signal text-surface hover:bg-signal-dark",
  secondary: "border border-ink bg-transparent text-ink hover:bg-ink hover:text-canvas",
};
const classes = `${base} ${variants[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} disabled={disabled} class={classes} {...rest}>
      <slot />
    </button>
  )
}
