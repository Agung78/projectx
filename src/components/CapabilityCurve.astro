---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const phases = [
  { label: "Diagnose", newco: 92, client: 8 },
  { label: "Build With", newco: 74, client: 30 },
  { label: "Run With", newco: 48, client: 58 },
  { label: "Hand Over", newco: 22, client: 82 },
  { label: "Advise", newco: 10, client: 94 },
];

const captionText = "Handover is a success metric, not a hidden failure condition.";

/*
 * Two renderings of one idea, chosen by available width rather than by
 * shrinking a single drawing: the SVG curve needs roughly the full content
 * width for its five phase labels to stay legible, so narrow columns and
 * mobile get paired ownership bars instead. Both carry the same numbers.
 */
const width = 1120;
const height = 320;
const padX = 60;
const padTop = 40;
const padBottom = 56;
const plotHeight = height - padTop - padBottom;
const stepX = (width - padX * 2) / (phases.length - 1);

function toY(value: number) {
  return padTop + plotHeight * (1 - value / 100);
}

function pathFor(key: "newco" | "client") {
  return phases
    .map((phase, i) => `${i === 0 ? "M" : "L"} ${padX + stepX * i} ${toY(phase[key])}`)
    .join(" ");
}

const newcoPath = pathFor("newco");
const clientPath = pathFor("client");

// Both variants can render on one page, so the SVG's labelling ids must be unique.
const uid = compact ? "compact" : "full";
const titleId = `capability-curve-title-${uid}`;
const descId = `capability-curve-desc-${uid}`;
const descText =
  "A line chart across five phases (Diagnose, Build With, Run With, Hand Over, Advise) showing NewCo's day-to-day ownership decreasing from high to low while the client's ownership increases from low to high.";
---

<div data-capability-curve>
  {
    !compact && (
      <div class="hidden md:block">
        <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={`${titleId} ${descId}`} class="w-full">
          <title id={titleId}>Capability transfer curve</title>
          <desc id={descId}>{descText}</desc>

          {phases.map((_phase, i) => (
            <line
              x1={padX + stepX * i}
              y1={padTop}
              x2={padX + stepX * i}
              y2={padTop + plotHeight}
              stroke="var(--color-line)"
              stroke-width="1"
            />
          ))}

          <path d={newcoPath} fill="none" stroke="var(--color-graphite)" stroke-width="2.5" data-curve-line />
          <path d={clientPath} fill="none" stroke="var(--color-signal)" stroke-width="2.5" data-curve-line />

          {phases.map((phase, i) => (
            <>
              <circle cx={padX + stepX * i} cy={toY(phase.newco)} r="4" fill="var(--color-graphite)" />
              <circle cx={padX + stepX * i} cy={toY(phase.client)} r="4" fill="var(--color-signal)" />
              <text
                x={padX + stepX * i}
                y={height - 20}
                text-anchor="middle"
                class="fill-ink"
                style="font-size: 15px; font-weight: 600;"
              >
                {phase.label}
              </text>
            </>
          ))}
        </svg>

        <div class="mt-4 flex items-center gap-6 label text-graphite">
          <span class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-graphite" aria-hidden="true" />
            NewCo day-to-day ownership
          </span>
          <span class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-signal" aria-hidden="true" />
            Client ownership
          </span>
        </div>
      </div>
    )
  }

  <div class:list={[compact ? "" : "md:hidden"]}>
    <p class="label flex flex-wrap items-center gap-x-6 gap-y-2 text-graphite">
      <span class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-graphite" aria-hidden="true"></span>
        NewCo
      </span>
      <span class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-signal" aria-hidden="true"></span>
        Client
      </span>
      <span class="ml-auto normal-case tracking-normal">Day-to-day ownership</span>
    </p>

    <ol class:list={["flex flex-col divide-y divide-line border-y border-line", compact ? "mt-3" : "mt-4"]}>
      {
        phases.map((phase, i) => (
          <li class:list={["grid grid-cols-[2ch_1fr] items-baseline gap-x-4 gap-y-2", compact ? "py-2.5" : "py-4"]}>
            <span class="label text-graphite/70">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <p class="text-body font-semibold text-ink">{phase.label}</p>
              {/*
                Two stacked tracks rather than one split bar: a single bar reads
                as a ratio, and these are two independent ownership levels.
              */}
              <div class:list={["flex flex-col gap-1.5", compact ? "mt-2" : "mt-3"]}>
                <div class="flex items-center gap-3">
                  <span class="h-[3px] flex-1 bg-line" aria-hidden="true">
                    <span class="block h-full bg-graphite" style={`width:${phase.newco}%`} />
                  </span>
                  <span class="w-10 shrink-0 text-right text-body tabular-nums text-graphite">
                    {phase.newco}%
                  </span>
                </div>
                <div class="flex items-center gap-3">
                  <span class="h-[3px] flex-1 bg-line" aria-hidden="true">
                    <span class="block h-full bg-signal" style={`width:${phase.client}%`} />
                  </span>
                  <span class="w-10 shrink-0 text-right text-body tabular-nums text-signal">
                    {phase.client}%
                  </span>
                </div>
              </div>
              <span class="sr-only">
                NewCo ownership {phase.newco} percent, client ownership {phase.client} percent.
              </span>
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <p class:list={["font-medium text-ink", compact ? "mt-4 text-body" : "mt-6 text-body-lg"]}>
    {captionText}
  </p>
</div>
